---
import BaseLayout from '../layouts/BaseLayout.astro';
import Murupolku from '../components/Murupolku.astro';
import Vaiheet from '../components/Vaiheet.astro';
import Icon from '../components/Icon.astro';
import yritys from '../data/yritys.json';
const tel = `tel:${yritys.puhelinE164}`;
const kartta = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${yritys.katuosoite}, ${yritys.postinumero} ${yritys.kaupunki}`)}`;
---

<BaseLayout
  title="Yhteystiedot | Holske Oy, Vantaa"
  description={`Soita ${yritys.puhelinNaytto} tai lähetä sähköpostia ${yritys.sahkoposti}. Ilmainen kuntoarvio kattoremonteille ja maalaukselle pääkaupunkiseudulla.`}
>
  <section class="alku">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Yhteystiedot', href: '/yhteystiedot/' }]} />
      <div class="sisus">
        <div class="teksti">
          <h1 data-fit>Ota yhteyttä</h1>
          <p class="lead">
            Kuntoarvio on ilmainen. Katsomme kohteen paikan päällä, ja saat suunnitelman ja hinnan ilman sitoutumista.
          </p>
        </div>
        <div class="kanavat">
          <a href={tel} class="kanava">
            <span class="tyyppi"><Icon name="puhelin" size={20} /> Puhelin</span>
            <span class="arvo">{yritys.puhelinNaytto}</span>
          </a>
          <a href={`mailto:${yritys.sahkoposti}`} class="kanava">
            <span class="tyyppi"><Icon name="sahkoposti" size={20} /> Sähköposti</span>
            <span class="arvo">{yritys.sahkoposti}</span>
          </a>
        </div>
      </div>

      <dl class="tiedot">
        <div>
          <dt>Osoite</dt>
          <dd>
            {yritys.katuosoite}, {yritys.postinumero} {yritys.kaupunki}
            <a href={kartta} rel="noopener" target="_blank" class="kartta">Avaa kartalla</a>
          </dd>
        </div>
        <div><dt>Palvelualue</dt><dd>{yritys.palvelualue.join(', ')}</dd></div>
        <div><dt>Yritys</dt><dd>{yritys.nimi}, Y-tunnus {yritys.ytunnus}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>
</BaseLayout>

<style>
  .alku { padding-block: clamp(1.5rem, 4vw, 3rem) var(--section); }
  .sisus {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    margin: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 7vw, 5rem);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .sisus { grid-template-columns: 7fr 5fr; }
  }
  .teksti { display: grid; gap: 1.5rem; }
  .kanavat { display: grid; gap: 0.75rem; }
  .kanava {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 200ms ease, transform 150ms var(--ease-out);
  }
  .kanava:hover { background: var(--sand); color: var(--ink); }
  .tyyppi { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--muted); font-size: var(--fs-sm); }
  .arvo {
    font-family: var(--font-display);
    font-stretch: var(--stretch);
    font-size: clamp(24px, 1rem + 2vw, 40px);
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .tiedot { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .tiedot div { display: grid; gap: 0.25rem; padding: 1.25rem 0; }
  .tiedot div + div { border-top: 1px solid var(--line); }
  @media (min-width: 40rem) {
    .tiedot div { grid-template-columns: 12rem 1fr; gap: 1.5rem; }
  }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 500; color: var(--ink); display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .kartta { font-weight: 500; }
  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }
</style>
