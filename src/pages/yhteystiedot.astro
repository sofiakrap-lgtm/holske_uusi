---
import BaseLayout from '../layouts/BaseLayout.astro';
import Murupolku from '../components/Murupolku.astro';
import Vaiheet from '../components/Vaiheet.astro';
import yritys from '../data/yritys.json';
const tel = `tel:${yritys.puhelinE164}`;
const kartta = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${yritys.katuosoite}, ${yritys.postinumero} ${yritys.kaupunki}`)}`;
---

<BaseLayout
  title="Yhteystiedot | Holske Oy, Vantaa"
  description={`Soita ${yritys.puhelinNaytto} tai lähetä sähköpostia ${yritys.sahkoposti}. Ilmainen kuntoarvio kattoremonteille ja maalaukselle pääkaupunkiseudulla.`}
  piilotaMobiiliCta
>
  <section class="alku">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Yhteystiedot', href: '/yhteystiedot/' }]} />
      <div class="sisus">
        <h1>Yhteystiedot</h1>
        <p class="lead">Soita tai lähetä sähköpostia. Kuntoarvio on ilmainen, ja vastaamme nopeasti.</p>
        <a href={tel} class="numero">{yritys.puhelinNaytto}</a>
        <a href={`mailto:${yritys.sahkoposti}`} class="sposti">{yritys.sahkoposti}</a>
      </div>

      <dl class="tiedot">
        <div>
          <dt>Osoite</dt>
          <dd>
            {yritys.katuosoite}, {yritys.postinumero} {yritys.kaupunki}
            <a href={kartta} rel="noopener" target="_blank" class="kartta">Avaa kartalla</a>
          </dd>
        </div>
        <div><dt>Palvelualue</dt><dd>{yritys.palvelualue.join(', ')}</dd></div>
        <div><dt>Yritys</dt><dd>{yritys.nimi}, Y-tunnus {yritys.ytunnus}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>
</BaseLayout>

<style>
  .alku { padding-block: clamp(1.5rem, 4vw, 3rem) var(--section); }
  .sisus {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
    max-width: 48rem;
    margin: clamp(1rem, 4vw, 3rem) auto clamp(3rem, 7vw, 5rem);
  }
  .sisus .lead { margin-inline: auto; }
  .numero {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--green);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .numero:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  }
  .sposti { font-size: var(--fs-lg); font-weight: 600; min-height: 48px; display: inline-flex; align-items: center; }
  .tiedot { margin: 0 auto; max-width: 44rem; border-top: 1px solid var(--line); }
  .tiedot div { display: grid; gap: 0.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 40rem) {
    .tiedot div { grid-template-columns: 10rem 1fr; gap: 1.5rem; }
  }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 500; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .kartta { font-weight: 600; }
  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }
</style>
