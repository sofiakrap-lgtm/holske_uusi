---
import BaseLayout from '../layouts/BaseLayout.astro';
import Murupolku from '../components/Murupolku.astro';
import Icon from '../components/Icon.astro';
import hinnasto from '../data/hinnasto.json';

const palvelut = [
  { id: 'katot', nimi: 'Katon maalaus tai pinnoitus', ikoni: 'katto' },
  { id: 'maalaus', nimi: 'Seinien maalaus', ikoni: 'maalaus' },
  { id: 'painepesu', nimi: 'Painepesu', ikoni: 'painepesu' },
  { id: 'lumityot', nimi: 'Lumityöt', ikoni: 'lumi' },
  { id: 'pihatyot', nimi: 'Ruohonleikkuu', ikoni: 'piha' },
];
---

<BaseLayout
  title="Hintalaskuri: katon maalaus, talon maalaus ja painepesu | Holske"
  description="Laske suuntaa-antava hinta katon maalaukselle, seinien maalaukselle, painepesulle, lumitöille tai ruohonleikkuulle. Lähetä tiedot suoraan ja saat tarkan hinnan ilmaisessa kuntoarviossa."
>
  <section class="section--tight alku">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Hintalaskuri', href: '/hintalaskuri/' }]} />
      <div class="section-head">
        <h1>Hintalaskuri</h1>
        <p class="lead">
          Vastaa muutamaan kysymykseen, niin näet suuntaa-antavan hinnan. Tarkka hinta selviää aina ilmaisessa
          kuntoarviossa, ja voit lähettää tiedot meille suoraan laskurista.
        </p>
      </div>

      <div class="asettelu">
        <form class="laskuri" data-laskuri novalidate>
          <fieldset class="vaihe">
            <legend><span class="nro">1</span> Mitä työtä tarvitset?</legend>
            <div class="palvelut">
              {
                palvelut.map((p) => (
                  <label class="palvelu">
                    <input type="radio" name="palvelu" value={p.id} />
                    <span class="palvelu-sisalto">
                      <Icon name={p.ikoni} size={30} />
                      <span>{p.nimi}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="vaihe" data-osio="katot" hidden>
            <legend><span class="nro">2</span> Kerro katosta</legend>
            <div class="kentat">
              <div class="field">
                <span class="label" id="katto-tyyppi">Katon materiaali</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="katto-tyyppi">
                  <label><input type="radio" name="katto_tyyppi" value="pelti" checked /><span>Peltikatto, maalaus</span></label>
                  <label><input type="radio" name="katto_tyyppi" value="tiili" /><span>Tiilikatto, pinnoitus</span></label>
                </div>
              </div>
              <div class="field">
                <label for="katto_ala">Katon pinta-ala</label>
                <div class="yksikko"><input id="katto_ala" name="katto_ala" type="number" inputmode="decimal" min="1" step="1" /><span>m²</span></div>
                <p class="hint">Jos et tiedä, jätä tyhjäksi ja kerro alla talon pohjan pinta-ala.</p>
              </div>
              <div class="field">
                <label for="katto_pohja">Talon pohjan pinta-ala <span class="optional">(jos katon ala ei ole tiedossa)</span></label>
                <div class="yksikko"><input id="katto_pohja" name="katto_pohja" type="number" inputmode="decimal" min="1" step="1" /><span>m²</span></div>
              </div>
              <div class="field">
                <span class="label" id="katto-krs">Kerroksia</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="katto-krs">
                  <label><input type="radio" name="katto_krs" value="1" checked /><span>1</span></label>
                  <label><input type="radio" name="katto_krs" value="2" /><span>2 tai enemmän</span></label>
                </div>
              </div>
              <div class="field">
                <label for="katto_kunto">Katon kunto</label>
                <select id="katto_kunto" name="katto_kunto">
                  <option value="hyva">Hyvä, pinta vain haalistunut</option>
                  <option value="kohtalainen" selected>Kohtalainen, sammalta tai kulumaa</option>
                  <option value="huono">Huono, paljon ruostetta tai vaurioita</option>
                </select>
              </div>
              <label class="valinta"><input type="checkbox" name="katto_jyrkka" /> <span>Katto on jyrkkä</span></label>
              <label class="valinta" data-vain="pelti"><input type="checkbox" name="katto_ruoste" /> <span>Katolla on ruostetta, joka pitää poistaa</span></label>
            </div>
          </fieldset>

          <fieldset class="vaihe" data-osio="maalaus" hidden>
            <legend><span class="nro">2</span> Kerro seinistä</legend>
            <div class="kentat">
              <div class="field">
                <label for="maalaus_ala">Maalattava seinäpinta</label>
                <div class="yksikko"><input id="maalaus_ala" name="maalaus_ala" type="number" inputmode="decimal" min="1" step="1" /><span>m²</span></div>
                <p class="hint">Karkea arvio: talon ympärysmitta kertaa seinän korkeus.</p>
              </div>
              <div class="field">
                <span class="label" id="maalaus-kerrat">Maalauskerrat</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="maalaus-kerrat">
                  <label><input type="radio" name="maalaus_kerrat" value="1" checked /><span>Kerran</span></label>
                  <label><input type="radio" name="maalaus_kerrat" value="2" /><span>Kahdesti</span></label>
                </div>
                <p class="hint">Kerromme kuntoarviossa, riittääkö yksi kerta.</p>
              </div>
              <label class="valinta"><input type="checkbox" name="maalaus_pohjatyot" /> <span>Vanha maali hilseilee, pinta pitää pestä ja kaapia</span></label>
            </div>
          </fieldset>

          <fieldset class="vaihe" data-osio="painepesu" hidden>
            <legend><span class="nro">2</span> Mitä pestään?</legend>
            <p class="hint">Täytä pinta-ala niille kohteille, jotka haluat pestä.</p>
            <div class="kentat kentat--2">
              {
                [
                  ['pesu_katto', 'Katto'],
                  ['pesu_kiveys', 'Kiveys tai laatoitus'],
                  ['pesu_terassi', 'Terassi'],
                  ['pesu_julkisivu', 'Julkisivu'],
                ].map(([id, nimi]) => (
                  <div class="field">
                    <label for={id}>{nimi}</label>
                    <div class="yksikko"><input id={id} name={id} type="number" inputmode="decimal" min="0" step="1" /><span>m²</span></div>
                  </div>
                ))
              }
            </div>
            <label class="valinta"><input type="checkbox" name="pesu_suoja" /> <span>Katolle suoja-ainekäsittely pesun jälkeen</span></label>
          </fieldset>

          <fieldset class="vaihe" data-osio="lumityot" hidden>
            <legend><span class="nro">2</span> Lumityöt</legend>
            <div class="kentat">
              <div class="field">
                <span class="label" id="lumi-kohde">Mistä lumet poistetaan?</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="lumi-kohde">
                  <label><input type="radio" name="lumi_kohde" value="katto" checked /><span>Katolta</span></label>
                  <label><input type="radio" name="lumi_kohde" value="piha" /><span>Pihalta</span></label>
                  <label><input type="radio" name="lumi_kohde" value="molemmat" /><span>Molemmista</span></label>
                </div>
              </div>
              <div class="field" data-vain-lumi="katto">
                <span class="label" id="lumi-koko">Katon koko</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="lumi-koko">
                  <label><input type="radio" name="lumi_koko" value="pieni" checked /><span>Alle 150 m²</span></label>
                  <label><input type="radio" name="lumi_koko" value="iso" /><span>Yli 150 m²</span></label>
                </div>
              </div>
              <div class="field">
                <span class="label" id="lumi-sopimus">Kertakäynti vai koko talvi?</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="lumi-sopimus">
                  <label><input type="radio" name="lumi_sopimus" value="ei" checked /><span>Kertakäynti</span></label>
                  <label><input type="radio" name="lumi_sopimus" value="kylla" /><span>Talvisopimus</span></label>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="vaihe" data-osio="pihatyot" hidden>
            <legend><span class="nro">2</span> Ruohonleikkuu</legend>
            <div class="kentat">
              <div class="field">
                <span class="label" id="nurmi-koko">Nurmikon koko</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="nurmi-koko">
                  <label><input type="radio" name="nurmi_koko" value="pieni" checked /><span>Alle 500 m²</span></label>
                  <label><input type="radio" name="nurmi_koko" value="keski" /><span>500-1 000 m²</span></label>
                  <label><input type="radio" name="nurmi_koko" value="iso" /><span>Yli 1 000 m²</span></label>
                </div>
              </div>
              <div class="field">
                <span class="label" id="nurmi-sopimus">Kertakäynti vai koko kesä?</span>
                <div class="segmentti" role="radiogroup" aria-labelledby="nurmi-sopimus">
                  <label><input type="radio" name="nurmi_sopimus" value="ei" checked /><span>Kertakäynti</span></label>
                  <label><input type="radio" name="nurmi_sopimus" value="kylla" /><span>Kesäsopimus</span></label>
                </div>
              </div>
            </div>
          </fieldset>
        </form>

        <aside class="tulos" aria-labelledby="tulos-otsikko">
          <div class="tulos-kortti" data-tulos>
            <span class="nro nro--vaalea">3</span>
            <h2 id="tulos-otsikko">Hinta-arvio</h2>
            <div aria-live="polite" data-tulos-sisalto>
              <p class="tulos-tyhja">Valitse ensin palvelu.</p>
            </div>
            <button type="button" class="btn btn--block" data-jatka hidden>
              Lähetä tiedot ja varaa kuntoarvio <Icon name="nuoli" size={20} />
            </button>
            <p class="pienteksti">
              Arvio on suuntaa-antava eikä sido kumpaakaan. Hinta sisältää ALV:n. Tarkka hinta sovitaan kuntoarvion jälkeen.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/json" id="hinnasto" set:html={JSON.stringify(hinnasto)} />

<script>
  import { laske, euro, type Hinnasto, type Syote } from '../lib/laskuri';

  const hinnasto: Hinnasto = JSON.parse(document.getElementById('hinnasto')!.textContent || '{}');
  const form = document.querySelector<HTMLFormElement>('[data-laskuri]')!;
  const sisalto = document.querySelector<HTMLElement>('[data-tulos-sisalto]')!;
  const jatka = document.querySelector<HTMLButtonElement>('[data-jatka]')!;

  const nimet: Record<string, string> = {
    katot: 'Katon maalaus tai pinnoitus',
    maalaus: 'Seinien maalaus',
    painepesu: 'Painepesu',
    lumityot: 'Lumityöt',
    pihatyot: 'Ruohonleikkuu',
  };
  const fd = () => new FormData(form);
  const luku = (n: string) => {
    const v = parseFloat(String(fd().get(n) ?? '').replace(',', '.'));
    return Number.isFinite(v) && v > 0 ? v : null;
  };
  const arvo = (n: string) => String(fd().get(n) ?? '');
  const ruksi = (n: string) => fd().get(n) === 'on';

  function syote(): Syote | null {
    switch (arvo('palvelu')) {
      case 'katot':
        return {
          palvelu: 'katot',
          tyyppi: arvo('katto_tyyppi') === 'tiili' ? 'tiili' : 'pelti',
          ala: luku('katto_ala'),
          pohjaAla: luku('katto_pohja'),
          kerrokset: arvo('katto_krs') === '2' ? 2 : 1,
          jyrkka: ruksi('katto_jyrkka'),
          kunto: (arvo('katto_kunto') || 'kohtalainen') as 'hyva' | 'kohtalainen' | 'huono',
          ruoste: ruksi('katto_ruoste'),
        };
      case 'maalaus':
        return { palvelu: 'maalaus', ala: luku('maalaus_ala'), kerrat: arvo('maalaus_kerrat') === '2' ? 2 : 1, pohjatyot: ruksi('maalaus_pohjatyot') };
      case 'painepesu':
        return {
          palvelu: 'painepesu',
          katto: luku('pesu_katto'),
          kiveys: luku('pesu_kiveys'),
          terassi: luku('pesu_terassi'),
          julkisivu: luku('pesu_julkisivu'),
          suojaAine: ruksi('pesu_suoja'),
        };
      case 'lumityot':
        return {
          palvelu: 'lumityot',
          kohde: (arvo('lumi_kohde') || 'katto') as 'katto' | 'piha' | 'molemmat',
          kattoKoko: arvo('lumi_koko') === 'iso' ? 'iso' : 'pieni',
          sopimus: arvo('lumi_sopimus') === 'kylla',
        };
      case 'pihatyot':
        return { palvelu: 'pihatyot', nurmi: (arvo('nurmi_koko') || 'pieni') as 'pieni' | 'keski' | 'iso', sopimus: arvo('nurmi_sopimus') === 'kylla' };
      default:
        return null;
    }
  }

  // Selkokielinen yhteenveto, joka siirtyy kuntoarviolomakkeen viestikenttään
  function yhteenveto(s: Syote): string {
    const r: string[] = [`Hintalaskurista: ${nimet[s.palvelu]}`];
    const m2 = (n: number | null) => (n ? `${n} m²` : 'ei tiedossa');
    if (s.palvelu === 'katot') {
      r.push(`Katto: ${s.tyyppi === 'pelti' ? 'peltikatto, maalaus' : 'tiilikatto, pinnoitus'}`);
      r.push(`Katon ala: ${m2(s.ala)}${!s.ala && s.pohjaAla ? `, talon pohja ${s.pohjaAla} m²` : ''}`);
      r.push(`Kerroksia: ${s.kerrokset === 2 ? '2 tai enemmän' : '1'}`);
      r.push(`Kunto: ${{ hyva: 'hyvä', kohtalainen: 'kohtalainen', huono: 'huono' }[s.kunto]}`);
      if (s.jyrkka) r.push('Jyrkkä katto');
      if (s.tyyppi === 'pelti' && s.ruoste) r.push('Ruostetta poistettava');
    }
    if (s.palvelu === 'maalaus') {
      r.push(`Seinäpinta: ${m2(s.ala)}`, `Maalauskerrat: ${s.kerrat}`);
      if (s.pohjatyot) r.push('Pohjatyöt tarpeen (pesu ja kaavinta)');
    }
    if (s.palvelu === 'painepesu') {
      if (s.katto) r.push(`Katto: ${s.katto} m²`);
      if (s.kiveys) r.push(`Kiveys/laatoitus: ${s.kiveys} m²`);
      if (s.terassi) r.push(`Terassi: ${s.terassi} m²`);
      if (s.julkisivu) r.push(`Julkisivu: ${s.julkisivu} m²`);
      if (s.suojaAine) r.push('Katolle suoja-aine');
    }
    if (s.palvelu === 'lumityot') {
      r.push(`Kohde: ${{ katto: 'katto', piha: 'piha', molemmat: 'katto ja piha' }[s.kohde]}`);
      if (s.kohde !== 'piha') r.push(`Katon koko: ${s.kattoKoko === 'iso' ? 'yli 150 m²' : 'alle 150 m²'}`);
      r.push(s.sopimus ? 'Talvisopimus' : 'Kertakäynti');
    }
    if (s.palvelu === 'pihatyot') {
      r.push(`Nurmikko: ${{ pieni: 'alle 500 m²', keski: '500-1 000 m²', iso: 'yli 1 000 m²' }[s.nurmi]}`);
      r.push(s.sopimus ? 'Kesäsopimus' : 'Kertakäynti');
    }
    return r.join('\n');
  }

  let viimeisin: { s: Syote; arvio: string } | null = null;

  function paivita() {
    const palvelu = arvo('palvelu');
    form.querySelectorAll<HTMLElement>('[data-osio]').forEach((el) => (el.hidden = el.dataset.osio !== palvelu));
    const pelti = arvo('katto_tyyppi') !== 'tiili';
    form.querySelectorAll<HTMLElement>('[data-vain="pelti"]').forEach((el) => (el.hidden = !pelti));
    const lumiKatto = arvo('lumi_kohde') !== 'piha' && arvo('lumi_sopimus') !== 'kylla';
    form.querySelectorAll<HTMLElement>('[data-vain-lumi="katto"]').forEach((el) => (el.hidden = !lumiKatto));

    const s = syote();
    if (!s) {
      sisalto.innerHTML = '<p class="tulos-tyhja">Valitse ensin palvelu.</p>';
      jatka.hidden = true;
      viimeisin = null;
      return;
    }
    const t = laske(hinnasto, s);
    let html = '';
    let arvio = '';
    if (t.hinta !== null && t.alaraja !== null && t.ylaraja !== null) {
      const kk = t.kuukausihinta ? ' / kk' : '';
      const naytto = hinnasto.yleiset.naytto;
      if (naytto === 'alkaen') arvio = `alkaen ${euro(t.alaraja)}${kk}`;
      else if (naytto === 'haarukka' && t.alaraja !== t.ylaraja) arvio = `${euro(t.alaraja)} - ${euro(t.ylaraja)}${kk}`;
      else arvio = `noin ${euro(t.hinta)}${kk}`;
      html += `<p class="tulos-hinta">${arvio}</p>`;
      if (t.ala) html += `<p class="tulos-rivi">Laskettu ${Math.round(t.ala)} m² mukaan</p>`;
      if (t.vahennyksenJalkeen !== null)
        html += `<p class="tulos-rivi tulos-kv">Kotitalousvähennyksen jälkeen noin <strong>${euro(t.vahennyksenJalkeen)}</strong>, jos vähennys on käytettävissä.</p>`;
    } else if (t.puuttuu === 'mitat') {
      html += '<p class="tulos-tyhja">Täytä pinta-ala, niin lasketaan.</p><p class="tulos-rivi">Voit myös jatkaa suoraan ilman mittoja. Mittaamme kohteen kuntoarviossa.</p>';
    } else {
      html +=
        '<p class="tulos-otsikko">Tarkka hinta kuntoarviossa</p><p class="tulos-rivi">Tämän työn hinta riippuu kohteesta niin paljon, että annamme sen vasta nähtyämme kohteen. Lähetä tiedot, niin otamme yhteyttä.</p>';
    }
    sisalto.innerHTML = html;
    jatka.hidden = false;
    viimeisin = { s, arvio };
  }

  form.addEventListener('input', paivita);
  form.addEventListener('change', paivita);
  paivita();

  jatka.addEventListener('click', () => {
    if (!viimeisin) return;
    const teksti = yhteenveto(viimeisin.s) + (viimeisin.arvio ? `\nLaskurin arvio: ${viimeisin.arvio}` : '');
    try {
      sessionStorage.setItem(
        'holske-laskuri',
        JSON.stringify({ palvelu: viimeisin.s.palvelu, yhteenveto: teksti, arvio: viimeisin.arvio }),
      );
    } catch {}
    location.href = `/kuntoarvio/?palvelu=${viimeisin.s.palvelu}&lahde=laskuri`;
  });
</script>

<style>
  .alku { padding-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: var(--section); }
  .asettelu {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 62rem) {
    .asettelu { grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; }
    .tulos { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .laskuri { display: grid; gap: 1.25rem; min-width: 0; }
  .vaihe {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vaihe:not([hidden]) { animation: esiin 360ms var(--ease-out) both; }
    @keyframes esiin {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
  }
  legend {
    float: left;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem);
    color: var(--green);
    line-height: 1.15;
  }
  legend + * { clear: both; }
  .nro {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font: 600 1rem/1 var(--font-body);
  }
  .nro--vaalea { background: color-mix(in srgb, #fff 18%, transparent); }

  .palvelut {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
  }
  .palvelu { position: relative; cursor: pointer; }
  .palvelu input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; min-height: 0; }
  .palvelu-sisalto {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    height: 100%;
    padding: 1.1rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    transition: border-color 150ms ease, background-color 150ms ease, transform 120ms var(--ease-out);
  }
  .palvelu-sisalto :global(.icon) { color: var(--green); }
  .palvelu:hover .palvelu-sisalto { border-color: color-mix(in srgb, var(--green) 40%, var(--line)); }
  .palvelu:active .palvelu-sisalto { transform: scale(0.98); }
  .palvelu input:checked + .palvelu-sisalto {
    border-color: var(--green);
    background: var(--moss-soft);
    box-shadow: inset 0 0 0 1px var(--green);
  }
  .palvelu input:focus-visible + .palvelu-sisalto { outline: 3px solid var(--orange); outline-offset: 2px; }

  .kentat { display: grid; gap: 1.25rem; }
  .kentat--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .label { font-weight: 600; }
  .yksikko { position: relative; max-width: 14rem; }
  .yksikko input { padding-right: 3.25rem; font-variant-numeric: tabular-nums; }
  .yksikko span {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .segmentti {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
