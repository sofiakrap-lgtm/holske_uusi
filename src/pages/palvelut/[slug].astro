---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Murupolku from '../../components/Murupolku.astro';
import Kuva from '../../components/Kuva.astro';
import Icon from '../../components/Icon.astro';
import Ukk from '../../components/Ukk.astro';
import CtaOsio from '../../components/CtaOsio.astro';
import yritys from '../../data/yritys.json';

export async function getStaticPaths() {
  const palvelut = await getCollection('palvelut');
  return palvelut.map((p) => ({ params: { slug: p.id }, props: { palvelu: p } }));
}

const { palvelu } = Astro.props;
const { Content } = await render(palvelu);
const d = palvelu.data;
const muut = (await getCollection('palvelut'))
  .filter((p) => p.id !== palvelu.id)
  .sort((a, b) => a.data.jarjestys - b.data.jarjestys)
  .slice(0, 4);
const site = Astro.site ?? new URL('https://holske.fi');
const tel = `tel:${yritys.puhelinE164}`;

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.otsikko,
    serviceType: d.nimi,
    description: d.kuvaus,
    url: new URL(`/palvelut/${palvelu.id}/`, site).href,
    provider: { '@id': `${site.href}#yritys` },
    areaServed: yritys.palvelualue.map((k) => ({ '@type': 'City', name: k })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: d.nimi,
      itemListElement: d.alapalvelut.map((a) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: a.nimi, description: a.teksti },
      })),
    },
  },
];
if (d.ukk.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.ukk.map((q) => ({
      '@type': 'Question',
      name: q.k,
      acceptedAnswer: { '@type': 'Answer', text: q.v },
    })),
  });
}
import { getKuva } from '../../lib/kuvat';
// Lisäkuvat näytetään vain, jos ne on lisätty kansioon (esim. katot-2.jpg, katot-3.jpg)
const lisakuvat = [`${d.kuva}-2`, `${d.kuva}-3`].filter((n) => getKuva(n));
const alapalvelut = d.alapalvelut.filter((a) => !a.teksti.startsWith('TODO'));
---

<BaseLayout title={d.seoTitle} description={d.kuvaus} schema={schema}>
  <section class="hero">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Palvelut', href: '/palvelut/' }, { nimi: d.nimi, href: `/palvelut/${palvelu.id}/` }]} />
      <div class="hero-teksti">
        <h1>{d.otsikko}</h1>
        <p class="lead">{d.ingressi}</p>
        <div class="toiminnot">
          <a href={tel} class="btn"><Icon name="puhelin" size={20} /> Soita {yritys.puhelinNaytto}</a>
          <a href={`mailto:${yritys.sahkoposti}`} class="sposti-linkki">{yritys.sahkoposti}</a>
        </div>
      </div>
    </div>
    <div class="taysi">
      <Kuva nimi={d.kuva} alt={d.kuvaAlt} ikoni={d.ikoni} variantti="hero" eager />
    </div>
  </section>

  {
    alapalvelut.length > 0 && (
      <section class="section" aria-labelledby="sisaltaa-otsikko">
        <div class="container kaksi">
          <h2 id="sisaltaa-otsikko">Mitä teemme</h2>
          <dl class="rivit">
            {alapalvelut.map((a) => (
              <div>
                <dt>{a.nimi}</dt>
                <dd>{a.teksti}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {
    lisakuvat.length > 0 && (
      <section class="section--tight" aria-label="Kuvia työstä">
        <div class="container lisakuvat">
          {lisakuvat.map((n) => <Kuva nimi={n} ikoni={d.ikoni} variantti="kortti" />)}
        </div>
      </section>
    )
  }

  <section class="section section--sand">
    <div class="container kaksi">
      <div></div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  {
    d.ukk.length > 0 && (
      <section class="section" aria-labelledby="ukk-otsikko">
        <div class="container kaksi">
          <h2 id="ukk-otsikko">Usein kysyttyä</h2>
          <Ukk kysymykset={d.ukk} />
        </div>
      </section>
    )
  }

  <CtaOsio />

  <section class="section--tight" aria-labelledby="muut-otsikko">
    <div class="container kaksi">
      <h2 id="muut-otsikko" class="pieni-otsikko">Muut palvelut</h2>
      <ul class="linkkirivit">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`}>
                <strong>{p.data.nimi}</strong>
                <Icon name="nuoli" size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  .hero-teksti {
    display: grid;
    gap: 1.4rem;
    justify-items: center;
    text-align: center;
    max-width: 52rem;
    margin: clamp(1rem, 3vw, 2rem) auto clamp(3rem, 6vw, 4.5rem);
  }
  .hero-teksti .lead { margin-inline: auto; }
  .toiminnot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
  }
  .sposti-linkki { display: inline-flex; align-items: center; min-height: 48px; font-weight: 600; font-size: var(--fs-lg); }
  .taysi { padding-inline: var(--gutter); }
  @media (min-width: 1180px) {
    .taysi { padding-inline: 0; }
  }
  .kaksi { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 60rem) {
    .kaksi { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; }
  }
  .prose { min-width: 0; }
  .rivit { margin: 0; border-top: 1px solid var(--line); }
  .rivit div { display: grid; gap: 0.35rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 44rem) {
    .rivit div { grid-template-columns: 13rem 1fr; gap: 2rem; }
  }
  .rivit dt { font-weight: 600; color: var(--green); font-size: 1.125rem; }
  .rivit dd { margin: 0; color: var(--muted); }
  .lisakuvat { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .pieni-otsikko { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem); }
  .linkkirivit { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .linkkirivit a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .linkkirivit strong { font-size: 1.1875rem; font-weight: 600; color: var(--green); }
  .linkkirivit :global(.icon) { flex: none; color: var(--green); transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .linkkirivit a:hover :global(.icon) { transform: translateX(6px); }
  }
</style>
