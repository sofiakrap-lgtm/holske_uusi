---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Murupolku from '../../components/Murupolku.astro';
import Kuva from '../../components/Kuva.astro';
import Icon from '../../components/Icon.astro';
import Ukk from '../../components/Ukk.astro';
import CtaOsio from '../../components/CtaOsio.astro';
import SanaOtsikko from '../../components/SanaOtsikko.astro';
import Bento from '../../components/Bento.astro';
import yritys from '../../data/yritys.json';

export async function getStaticPaths() {
  const palvelut = await getCollection('palvelut');
  return palvelut.map((p) => ({ params: { slug: p.id }, props: { palvelu: p } }));
}

const { palvelu } = Astro.props;
const { Content } = await render(palvelu);
const d = palvelu.data;
const muut = (await getCollection('palvelut'))
  .filter((p) => p.id !== palvelu.id)
  .sort((a, b) => a.data.jarjestys - b.data.jarjestys)
;
const site = Astro.site ?? new URL('https://holske.fi');

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.otsikko,
    serviceType: d.nimi,
    description: d.kuvaus,
    url: new URL(`/palvelut/${palvelu.id}/`, site).href,
    provider: { '@id': `${site.href}#yritys` },
    areaServed: yritys.palvelualue.map((k) => ({ '@type': 'City', name: k })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: d.nimi,
      itemListElement: d.alapalvelut.map((a) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: a.nimi, description: a.teksti },
      })),
    },
  },
];
if (d.ukk.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.ukk.map((q) => ({
      '@type': 'Question',
      name: q.k,
      acceptedAnswer: { '@type': 'Answer', text: q.v },
    })),
  });
}
import { getKuva } from '../../lib/kuvat';
// Lisäkuvat näytetään vain, jos ne on lisätty kansioon (esim. katot-2.jpg, katot-3.jpg)
const lisakuvat = [`${d.kuva}-2`, `${d.kuva}-3`].filter((n) => getKuva(n));
const alapalvelut = d.alapalvelut.filter((a) => !a.teksti.startsWith('TODO'));
const bentoSolut: { otsikko: string; teksti?: string; href?: string }[] = alapalvelut.map((a) => ({ otsikko: a.nimi, teksti: a.teksti }));
if (bentoSolut.length % 2 === 1) bentoSolut.push({ otsikko: 'Pyydä ilmainen kuntoarvio', teksti: 'Katsomme kohteen ja kerromme, mitä se tarvitsee.', href: '/yhteystiedot/' });
---

<BaseLayout title={d.seoTitle} description={d.kuvaus} schema={schema}>
  <section class="hero">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Palvelut', href: '/palvelut/' }, { nimi: d.nimi, href: `/palvelut/${palvelu.id}/` }]} />
      <div class="hero-ruudukko">
        <div class="hero-teksti">
          <SanaOtsikko teksti={d.otsikko} />
          <p class="lead saapuu" style="--i:4">{d.ingressi}</p>
          <div class="btn-row saapuu" style="--i:5">
            <a href="/yhteystiedot/" class="btn btn--iso">Ota yhteyttä</a>
          </div>
        </div>
        {
          getKuva(d.kuva) && (
            <div class="hero-kuva saapuu" style="--i:2">
              <Kuva nimi={d.kuva} alt={d.kuvaAlt} ikoni={d.ikoni} variantti="tayta" eager />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    bentoSolut.length > 0 && (
      <section class="section section--sand" aria-labelledby="sisaltaa-otsikko">
        <div class="container">
          <div class="osio-otsake">
            <h2 id="sisaltaa-otsikko">Mitä teemme</h2>
          </div>
          <Bento kuva={`${d.kuva}-2`} solut={bentoSolut} korostus={bentoSolut.length - 1} />
        </div>
      </section>
    )
  }

  {
    lisakuvat.length > 0 && (
      <section class="section--tight" aria-label="Kuvia työstä">
        <div class="container lisakuvat">
          {lisakuvat.map((n) => <Kuva nimi={n} ikoni={d.ikoni} variantti="kortti" class="reveal" />)}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  {
    d.ukk.length > 0 && (
      <section class="section section--sand" aria-labelledby="ukk-otsikko">
        <div class="container ukk-ruudukko">
          <div class="ukk-otsake">
            <h2 id="ukk-otsikko">Usein kysyttyä</h2>
            <a href="/yhteystiedot/" class="btn btn--secondary">Ota yhteyttä</a>
          </div>
          <Ukk kysymykset={d.ukk} />
        </div>
      </section>
    )
  }

  <section class="section--tight" aria-labelledby="muut-otsikko">
    <div class="container">
      <h2 id="muut-otsikko" class="pieni-otsikko">Muut palvelut</h2>
      <ul class="muut">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`}>
                {p.data.nimi}
                <Icon name="nuoli" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  .hero { padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem); }
  .hero-ruudukko { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: center; margin-top: clamp(1.5rem, 4vw, 3rem); }
  @media (min-width: 64rem) {
    .hero-ruudukko:has(.hero-kuva) { grid-template-columns: 7fr 5fr; }
  }
  .hero-teksti { display: grid; gap: 1.75rem; justify-items: start; }
  .hero-teksti :global(h1) { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem); }
  .hero-kuva { position: relative; aspect-ratio: 1 / 1; border-radius: var(--r-lg); overflow: hidden; }
  .hero-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
  .lisakuvat { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .ukk-ruudukko { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 64rem) {
    .ukk-ruudukko { grid-template-columns: 5fr 7fr; }
  }
  .ukk-otsake { display: grid; gap: 1.25rem; justify-items: start; }
  .pieni-otsikko { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem); margin-bottom: 1.5rem; }
  .muut { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .muut a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.875rem;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms ease;
  }
  .muut a:hover { background: var(--sand); }
  .muut :global(.icon) { transition: transform 200ms var(--ease-out); }
  .muut a:hover :global(.icon) { transform: translateX(3px); }
</style>
