---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Vaiheet from '../../components/Vaiheet.astro';
import Kuva from '../../components/Kuva.astro';
import Icon from '../../components/Icon.astro';
import Ukk from '../../components/Ukk.astro';
import CtaOsio from '../../components/CtaOsio.astro';
import HeroLead from '../../components/HeroLead.astro';
import Bento from '../../components/Bento.astro';
import Galleria from '../../components/Galleria.astro';
import Tiesitko from '../../components/Tiesitko.astro';
import yritys from '../../data/yritys.json';

export async function getStaticPaths() {
  const palvelut = await getCollection('palvelut');
  return palvelut.map((p) => ({ params: { slug: p.id }, props: { palvelu: p } }));
}

const { palvelu } = Astro.props;
const { Content } = await render(palvelu);
const d = palvelu.data;
const muut = (await getCollection('palvelut'))
  .filter((p) => p.id !== palvelu.id)
  .sort((a, b) => a.data.jarjestys - b.data.jarjestys)
;
const site = Astro.site ?? new URL('https://holske.fi');

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.otsikko,
    serviceType: d.nimi,
    description: d.kuvaus,
    url: new URL(`/palvelut/${palvelu.id}/`, site).href,
    provider: { '@id': `${site.href}#yritys` },
    areaServed: yritys.palvelualue.map((k) => ({ '@type': 'City', name: k })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: d.nimi,
      itemListElement: d.alapalvelut.map((a) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: a.nimi, description: a.teksti },
      })),
    },
  },
];
// Murupolku vain hakukoneille (näkyvä murupolku poistettu pääosiosta)
schema.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { nimi: 'Etusivu', href: '/' },
    { nimi: 'Palvelut', href: '/palvelut/' },
    { nimi: d.nimi, href: `/palvelut/${palvelu.id}/` },
  ].map((k, i) => ({ '@type': 'ListItem', position: i + 1, name: k.nimi, item: new URL(k.href, site).href })),
});
if (d.ukk.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.ukk.map((q) => ({
      '@type': 'Question',
      name: q.k,
      acceptedAnswer: { '@type': 'Answer', text: q.v },
    })),
  });
}
import { getKuva } from '../../lib/kuvat';
// Lisäkuvat näytetään vain, jos ne on lisätty kansioon (esim. katot-2.jpg, katot-3.jpg)
const lisakuvat = [`${d.kuva}-2`, `${d.kuva}-3`].filter((n) => getKuva(n));
const alapalvelut = d.alapalvelut.filter((a) => !a.teksti.startsWith('TODO'));
const bentoSolut: { otsikko: string; teksti?: string; href?: string; ikoni?: string }[] = alapalvelut.map((a) => ({
  otsikko: a.nimi,
  teksti: a.teksti,
  ikoni: a.ikoni ?? d.ikoni,
}));
// Kuva tekstiosion viereen: oma <kuva>-3, muuten jokin toinen kuva kuin pääosiossa
const SIVUKUVAT: Record<string, [string, string]> = {
  katot: ['katto-huolto', 'etusivu-mobiili'],
  maalaus: ['etusivu-mobiili', 'etusivu'],
};
const [sk1, sk2] = SIVUKUVAT[palvelu.id] ?? ['etusivu', 'etusivu-mobiili'];
const sivukuvat = [
  [`${d.kuva}-3`, sk1, d.kuva],
  [`${d.kuva}-4`, sk2, d.kuva],
];
if (bentoSolut.length % 2 === 1) bentoSolut.push({ otsikko: 'Pyydä ilmainen kuntoarvio', teksti: 'Katsomme kohteen ja kerromme, mitä se tarvitsee.', href: '/yhteystiedot/' });
---

<BaseLayout title={d.seoTitle} description={d.kuvaus} schema={schema}>
  <HeroLead
    rivit={[d.nimi, '', d.otsikko]}
    kuva={[d.kuva, 'etusivu']}
    video={palvelu.id}
    usva={false}
    ingressi={d.ingressi}
  />

  {
    bentoSolut.length > 0 && (
      <section data-theme="light-grey" aria-labelledby="sisaltaa-otsikko">
        <div class="container">
          <div class="osio-otsake">
            <h2 id="sisaltaa-otsikko" data-fit>Mitä teemme</h2>
          </div>
          <Bento
            kuva={`${d.kuva}-2`}
            vara={['etusivu', d.kuva]}
            solut={bentoSolut}
            korostus={bentoSolut.length - 1}
          />
        </div>
      </section>
    )
  }

  <section data-theme="birch">
    <div class="container jako">
      <div class="jako-kuvat">
        {
          sivukuvat.map(([nimi, ...vara]) => (
            <div class="jako-kuva">
              <Kuva nimi={nimi} vara={vara} variantti="tayta" />
            </div>
          ))
        }
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
    {
      d.tiesitko && (
        <div class="container nosto">
          <Tiesitko {...d.tiesitko} />
        </div>
      )
    }
  </section>

  {
    lisakuvat.length > 0 && (
      <section data-theme="birch" class="lisakuvat-osio" aria-label="Kuvia työstä">
        <div class="container lisakuvat">
          {lisakuvat.map((n) => <Kuva nimi={n} ikoni={d.ikoni} variantti="kortti" />)}
        </div>
      </section>
    )
  }

  <section data-theme="light-grey" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="vaiheet-otsikko" data-fit>Näin työ etenee</h2>
        <p>Neljä vaihetta yhteydenotosta valmiiseen työhön.</p>
      </div>
      <Vaiheet />
    </div>
  </section>

  {
    d.ukk.length > 0 && (
      <section data-theme="metsa" aria-labelledby="ukk-otsikko">
        <div class="container ukk-ruudukko">
          <div class="ukk-otsake">
            <h2 id="ukk-otsikko" data-fit>Kysymyksiä</h2>
            <a href="/yhteystiedot/" class="btn">Ota yhteyttä</a>
          </div>
          <Ukk kysymykset={d.ukk} />
        </div>
      </section>
    )
  }

  <section data-theme="light-grey" aria-labelledby="kuvat-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="kuvat-otsikko" data-fit>Lyhyesti</h2>
        <p>{d.kortti}</p>
      </div>
      <ul class="kohdat">
        {
          alapalvelut.map((a) => (
            <li>
              <Icon name="check" size={18} />
              {a.nimi}
            </li>
          ))
        }
        <li>
          <Icon name="kuntoarvio" size={18} />
          Ilmainen kuntoarvio
        </li>
      </ul>
    </div>
    <Galleria />
  </section>

  <section data-theme="birch" class="muut-osio" aria-labelledby="muut-otsikko">
    <div class="container">
      <h2 id="muut-otsikko" class="pieni-otsikko">Muut palvelut</h2>
      <ul class="muut">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`} class="muu on-light">
                <span class="muu-kuva">
                  <Kuva nimi={p.data.kuva} vara={['etusivu']} alt={p.data.kuvaAlt} variantti="tayta" />
                </span>
                <span class="muu-nimi">
                  <Icon name={p.data.ikoni} size={22} />
                  {p.data.nimi}
                  <Icon name="nuoli" size={20} class="muu-nuoli" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  /* Teksti ja kuva rinnakkain */
  .jako { display: grid; gap: var(--section-gap); }
  @media (min-width: 1025px) {
    .jako { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  .jako-kuvat { display: grid; gap: 24px; grid-template-columns: 1fr 1fr; }
  .jako-kuva { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-md); overflow: hidden; }
  /* Desktopilla kuvat pinossa, yhteensä yhtä korkeat kuin teksti */
  @media (min-width: 1025px) {
    .jako { align-items: stretch; }
    .jako-kuvat { grid-template-columns: 1fr; grid-auto-rows: minmax(14rem, 1fr); }
    .jako-kuva { aspect-ratio: auto; }
  }
  .jako-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
  .nosto { margin-top: var(--section-gap); }
  .lisakuvat-osio { padding-top: 0; }
  .lisakuvat { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .kohdat {
    list-style: none;
    margin: 0 0 var(--section-gap);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .kohdat li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--p-birch);
    color: var(--p-asphalt);
    font: 600 16px/1 var(--font-body);
  }
  .ukk-ruudukko { display: grid; gap: var(--section-gap); }
  @media (min-width: 1025px) {
    .ukk-ruudukko { grid-template-columns: 1fr 1.4fr; align-items: start; }
  }
  .ukk-otsake { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  @media (min-width: 1025px) {
    .ukk-otsake { align-items: flex-start; text-align: left; }
  }
  .muut-osio { padding-block: 96px; }
  .pieni-otsikko { text-align: center; font-size: clamp(28px, 4vw, 40px); margin-bottom: 32px; }
  .muut {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .muu {
    display: grid;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--p-grey-50);
    color: var(--ink);
    text-decoration: none;
  }
  .muu-kuva { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .muu-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; transition: transform 400ms var(--ease-out); }
  .muu:hover .muu-kuva :global(.kuvapaikka) { transform: scale(1.03); }
  .muu-nimi { display: flex; align-items: center; gap: 10px; padding: 18px 20px; font: 600 17px/1.2 var(--font-body); }
  .muu-nimi :global(.muu-nuoli) { margin-left: auto; transition: transform var(--dur-fast) ease; }
  .muu:hover .muu-nimi :global(.muu-nuoli) { transform: translateX(4px); }
</style>
