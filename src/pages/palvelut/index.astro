---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Kuva from '../../components/Kuva.astro';
import CtaOsio from '../../components/CtaOsio.astro';
import Murupolku from '../../components/Murupolku.astro';
import { getKuva } from '../../lib/kuvat';

const palvelut = (await getCollection('palvelut')).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const ydin = palvelut.filter((p) => p.data.ydin);
const lisat = palvelut.filter((p) => !p.data.ydin);
---

<BaseLayout
  title="Palvelut: kattoremontit ja maalaus | Holske"
  description="Holsken palvelut omakotitaloille: kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus. Lisäksi painepesu, lumityöt, pihatyöt ja ulkokorjaukset."
>
  <section class="section--tight alku">
    <div class="container">
      <Murupolku polku={[{ nimi: 'Palvelut', href: '/palvelut/' }]} />
      <div class="otsake">
        <h1 data-fit>Palvelut</h1>
        <p class="lead">
          Erikoisalaamme ovat kattoremontit, katon maalaus ja talon maalaus. Hoidamme samalla myös muut omakotitalon
          ulkotyöt.
        </p>
      </div>

      <ul class="ydin">
        {
          ydin.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`} class="ydinkortti">
                {getKuva(p.data.kuva) ? (
                  <Kuva nimi={p.data.kuva} alt={p.data.kuvaAlt} ikoni={p.data.ikoni} variantti="kortti" />
                ) : (
                  <span class="profiilipohja"><Icon name={p.data.ikoni} size={64} /></span>
                )}
                <h2>{p.data.otsikko}</h2>
                <p>{p.data.kortti}</p>
                <span class="link-arrow">Lue lisää <Icon name="nuoli" size={18} /></span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="kaksi">
        <h2 class="pieni-otsikko">Muut palvelut</h2>
        <ul class="linkkirivit">
          {
            lisat.map((p) => (
              <li>
                <a href={`/palvelut/${p.id}/`}>
                  <span>
                    <strong>{p.data.nimi}</strong>
                    <span class="kuvaus">{p.data.kortti}</span>
                  </span>
                  <Icon name="nuoli" size={22} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  .alku { padding-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: var(--section); }
  .otsake { display: grid; gap: 1rem; max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .ydin {
    list-style: none;
    margin: 0 0 var(--section);
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .profiilipohja {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    padding: 2rem;
    border-radius: var(--r-md);
    background: var(--green-fill);
    color: var(--green-text-on);
  }
  .ydinkortti { display: grid; gap: 1rem; color: var(--ink); text-decoration: none; }
  .ydinkortti h2 { font-size: clamp(24px, 1rem + 1vw, 32px); font-weight: 500; text-transform: none; letter-spacing: 0.3px; line-height: 1.15; margin-top: 0.5rem; }
  .ydinkortti :global(.kuvapaikka) { border-radius: var(--r-md); }
  .ydinkortti p { color: var(--muted); }
  .ydinkortti :global(.kuvapaikka) { transition: transform 500ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .ydinkortti:hover :global(.kuvapaikka) { transform: scale(1.012); }
  }
  .kaksi { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 60rem) {
    .kaksi { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; }
  }
  .pieni-otsikko { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem); }
  .linkkirivit { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .linkkirivit a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .linkkirivit a > span { display: grid; gap: 0.25rem; min-width: 0; }
  .linkkirivit strong { font-size: 1.25rem; font-weight: 560; color: var(--ink); }
  .kuvaus { color: var(--muted); }
  .linkkirivit :global(.icon) { flex: none; color: var(--ink); transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .linkkirivit a:hover :global(.icon) { transform: translateX(6px); }
  }
</style>
