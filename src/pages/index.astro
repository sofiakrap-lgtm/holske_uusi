---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import Vaiheet from '../components/Vaiheet.astro';
import CtaOsio from '../components/CtaOsio.astro';
import yritys from '../data/yritys.json';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const muut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const tel = `tel:${yritys.puhelinE164}`;

// Vanhan sivun katto- ja maalaussisällöstä
const merkit = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
];
const huoltovalit = [
  { kohde: 'Uusi sinkitty peltikatto', vali: 'Ensimmäinen maalaus 2-3 vuoden kuluttua' },
  { kohde: 'Maalattu peltikatto', vali: 'Uusi maalaus 15-20 vuoden välein' },
  { kohde: 'Betonitiilikatto', vali: 'Pinnoitus, kun katto on 20-30 vuotta vanha' },
  { kohde: 'Puutalon ulkoseinät', vali: 'Uusi maalaus 5-10 vuoden välein' },
];
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys, ilmainen kuntoarvio."
>
  <section class="hero">
    <div class="container hero-teksti">
      <h1>Katon maalaus ja kattoremontit omakotitaloille</h1>
      <p class="lead">
        Kunnostamme, maalaamme ja pinnoitamme tiili-, pelti- ja huopakatot siististi ja kiinteään hintaan. Pieni
        perheyritys pääkaupunkiseudulta, tekijöillä yli 25 vuoden kokemus.
      </p>
      <div class="toiminnot">
        <a href={tel} class="btn"><Icon name="puhelin" size={20} /> Soita {yritys.puhelinNaytto}</a>
        <a href={`mailto:${yritys.sahkoposti}`} class="sposti-linkki">{yritys.sahkoposti}</a>
      </div>
    </div>
    <div class="taysi">
      <Kuva nimi="etusivu" ikoni="katto" variantti="hero" eager />
    </div>
  </section>

  <section class="section" aria-labelledby="katot-otsikko">
    <div class="container kaksi">
      <div class="otsake">
        <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
        <p>Tunnemme eri katemateriaalit ja toteutustavat. Työ tehdään siististi, laadukkaasti ja kiinteään hintaan.</p>
        <a href="/palvelut/katot/" class="link-arrow">Lue lisää kattotöistä <Icon name="nuoli" size={18} /></a>
      </div>
      <dl class="rivit">
        {
          katot.data.alapalvelut.map((a) => (
            <div>
              <dt>{a.nimi}</dt>
              <dd>{a.teksti}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="merkit-otsikko">
    <div class="container keskella">
      <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
      <p class="lead">Tikkaille ei tarvitse kiivetä itse. Kun huomaat jonkin näistä, on hyvä aika soittaa.</p>
    </div>
    <div class="taysi reveal">
      <Kuva nimi="katto-huolto" ikoni="katto" variantti="leveä" />
    </div>
    <div class="container">
      <ul class="merkit">
        {merkit.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="huolto-otsikko">
    <div class="container kaksi">
      <div class="otsake">
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
        <p>Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
      </div>
      <dl class="rivit">
        {
          huoltovalit.map((h) => (
            <div>
              <dt>{h.kohde}</dt>
              <dd>{h.vali}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section maalaus" aria-labelledby="maalaus-otsikko">
    <div class="container rinnakkain">
      <Kuva nimi="maalaus" ikoni="maalaus" variantti="jaettu" />
      <div class="otsake">
        <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
        <p>{maalaus.data.ingressi}</p>
        <p>
          Maalaamme rakennuksen yhteen tai kahteen kertaan pinnan kunnon mukaan. Lopuksi tarkistamme työn kanssasi,
          siivoamme työmaan ja kierrätämme jätteet asianmukaisesti.
        </p>
        <a href="/palvelut/maalaus/" class="link-arrow">Lue lisää talon maalauksesta <Icon name="nuoli" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>

  <section class="section" aria-labelledby="muut-otsikko">
    <div class="container kaksi">
      <div class="otsake">
        <h2 id="muut-otsikko">Myös nämä hoituvat</h2>
        <p>Teemme samalla muut omakotitalon ulkotyöt, kun niitä tarvitaan.</p>
      </div>
      <ul class="linkkirivit">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`}>
                <span>
                  <strong>{p.data.nimi}</strong>
                  <span class="kuvaus">{p.data.kortti}</span>
                </span>
                <Icon name="nuoli" size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand" id="meista" aria-labelledby="meista-otsikko">
    <div class="container rinnakkain rinnakkain--kaanteinen">
      <Kuva nimi="perheyritys" ikoni="perhe" variantti="jaettu" />
      <div class="otsake">
        <h2 id="meista-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
        <p>
          Olemme suomalainen perheyritys pääkaupunkiseudulta. {yritys.kokemusLause} Perhekeskeisyys on tärkeimpiä
          arvojamme, ja se auttaa meitä tekemään työmme tehokkaasti.
        </p>
        <p>
          Asiakkaan tarpeet ovat meille ensisijaisia. Joustavuus on toimintamme kulmakivi: muokkaamme työn sinun kohteesi
          mukaan.
        </p>
      </div>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  .hero { padding-top: clamp(3rem, 8vw, 7rem); }
  .hero-teksti {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hero-teksti .lead { margin-inline: auto; }
  .toiminnot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin-top: 0.5rem;
  }
  .sposti-linkki {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 600;
    font-size: var(--fs-lg);
  }

  /* Reunasta reunaan: pienillä näytöillä sivumarginaalein */
  .taysi { padding-inline: var(--gutter); }
  @media (min-width: 1180px) {
    .taysi { padding-inline: 0; }
  }

  .kaksi {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .kaksi { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; }
    .kaksi .otsake { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
  .otsake {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    min-width: 0;
  }
  .otsake > p { color: var(--muted); max-width: var(--measure); }

  .rivit { margin: 0; border-top: 1px solid var(--line); }
  .rivit div {
    display: grid;
    gap: 0.35rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 44rem) {
    .rivit div { grid-template-columns: 13rem 1fr; gap: 2rem; }
  }
  .rivit dt { font-weight: 600; color: var(--green); font-size: 1.125rem; }
  .rivit dd { margin: 0; color: var(--muted); }

  .keskella {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .keskella .lead { margin-inline: auto; }
  .merkit {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--green);
  }
  .merkit li { display: inline-flex; align-items: center; gap: 0.75rem; }
  .merkit li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  .rinnakkain {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .rinnakkain { grid-template-columns: 1fr 1fr; }
    .rinnakkain--kaanteinen > :first-child { order: 2; }
  }

  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }

  .linkkirivit { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .linkkirivit a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .linkkirivit a > span { display: grid; gap: 0.25rem; min-width: 0; }
  .linkkirivit strong { font-size: 1.25rem; font-weight: 600; color: var(--green); }
  .linkkirivit .kuvaus { color: var(--muted); }
  .linkkirivit :global(.icon) { flex: none; color: var(--green); transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .linkkirivit a:hover :global(.icon) { transform: translateX(6px); }
    .linkkirivit a:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }
  }
</style>
