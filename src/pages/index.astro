---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import SanaOtsikko from '../components/SanaOtsikko.astro';
import HeroMedia from '../components/HeroMedia.astro';
import Bento from '../components/Bento.astro';
import Vaiheet from '../components/Vaiheet.astro';
import Huoltovalit from '../components/Huoltovalit.astro';
import Ukk from '../components/Ukk.astro';
import CtaOsio from '../components/CtaOsio.astro';
import { getKuva } from '../lib/kuvat';
import yritys from '../data/yritys.json';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const muut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort((a, b) => a.data.jarjestys - b.data.jarjestys);

// Etusivulle vain ensimmäinen lause, koko teksti on palvelusivulla
const ekaLause = (t: string) => {
  const i = t.indexOf('. ');
  return i === -1 ? t : t.slice(0, i + 1);
};

const lupaukset = [
  { nimi: 'Ilmainen kuntoarvio', lause: 'Katsomme kohteen paikan päällä.', teksti: 'Saat selkeän suunnitelman ja hinnan ilman sitoutumista.' },
  { nimi: 'Kiinteä hinta', lause: 'Tiedät hinnan ennen aloitusta.', teksti: 'Saat kiinteän hinnan kuntoarvion jälkeen, ja päätät itse, jatketaanko.' },
  { nimi: 'Siisti työmaa', lause: 'Jätämme pihan siistimmäksi.', teksti: 'Lopuksi tarkistamme tuloksen kanssasi ja kierrätämme jätteet.' },
];

const kattoSolut = [
  ...katot.data.alapalvelut.map((a) => ({ otsikko: a.nimi, teksti: ekaLause(a.teksti) })),
  { otsikko: 'Lue lisää kattotöistä', href: '/palvelut/katot/' },
];

// Vanhan sivun kattosisällöstä
const merkit: { otsikko: string; teksti?: string; href?: string }[] = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
].map((m) => ({ otsikko: m }));
merkit.push({ otsikko: 'Huomasitko jonkin näistä? Ota yhteyttä', href: '/yhteystiedot/' });

const maalausSolut = [
  ...maalaus.data.alapalvelut.map((a) => ({ otsikko: a.nimi, teksti: a.teksti })),
  { otsikko: 'Lue lisää talon maalauksesta', href: '/palvelut/maalaus/' },
];

const ukk = [...katot.data.ukk, ...maalaus.data.ukk].slice(0, 6);
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys, ilmainen kuntoarvio."
>
  <section class="hero">
    <div class="container hero-ruudukko">
      <div class="hero-teksti">
        <SanaOtsikko teksti="Kattoremontit|ja katon maalaus|omakotitaloille" />
        <p class="hero-lead saapuu" style="--i:4">
          Pieni perheyritys pääkaupunkiseudulta. Kunnostamme, maalaamme ja pinnoitamme katot ja seinät kiinteään hintaan.
        </p>
        <div class="btn-row saapuu" style="--i:5">
          <a href="/yhteystiedot/" class="btn btn--iso">Ota yhteyttä</a>
          <a href="#kattotyot" class="link-arrow">Katso palvelut <Icon name="nuoli" size={18} /></a>
        </div>
      </div>
      <div class="saapuu" style="--i:2">
        <HeroMedia nimi="etusivu" kuvaus="Holske työssä omakotitalon katolla" />
      </div>
    </div>
  </section>

  <section class="section--tight lupaukset-osio" aria-label="Miksi Holske">
    <div class="container">
      <ul class="lupaukset">
        {
          lupaukset.map((l) => (
            <li class="reveal">
              <span class="eyebrow">{l.nimi}</span>
              <strong>{l.lause}</strong>
              <p>{l.teksti}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="kattotyot" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
        <p>{ekaLause(katot.data.ingressi)} {yritys.kokemusLause}</p>
      </div>
      <Bento kuva="katot" solut={kattoSolut} korostus={5} />
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="merkit-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
        <p>Tikkaille ei tarvitse kiivetä itse. Kun huomaat jonkin näistä, on hyvä aika pyytää kuntoarvio.</p>
      </div>
      <Bento kuva="katto-huolto" solut={merkit} korostus={5} />
    </div>
  </section>

  <section class="section" aria-labelledby="huolto-otsikko">
    <div class="container huolto">
      <div class="huolto-otsake">
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
        <p>Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella. Nämä ovat tavalliset välit, kuntoarviossa katsomme juuri sinun kohteesi.</p>
      </div>
      <Huoltovalit />
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="maalaus-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
        <p>{maalaus.data.ingressi}</p>
      </div>
      <Bento kuva="maalaus" solut={maalausSolut} korostus={3} />
    </div>
  </section>

  <section class="section" aria-labelledby="muut-otsikko">
    <div class="container">
      <div class="karuselli-otsake">
        <div class="osio-otsake">
          <h2 id="muut-otsikko">Myös nämä hoituvat</h2>
          <p>Teemme samalla muut omakotitalon ulkotyöt, kun niitä tarvitaan.</p>
        </div>
        <div class="karuselli-napit" aria-hidden="true">
          <button type="button" class="pyorea" data-karuselli-edellinen tabindex="-1"><Icon name="nuoli" size={20} class="kaannetty" /></button>
          <button type="button" class="pyorea" data-karuselli-seuraava tabindex="-1"><Icon name="nuoli" size={20} /></button>
        </div>
      </div>
    </div>
    <ul class="karuselli" data-karuselli aria-label="Muut palvelut">
      {
        muut.map((p) => (
          <li>
            <a href={`/palvelut/${p.id}/`} class="muu">
              <span class="muu-kuva">
                {getKuva(p.data.kuva) ? (
                  <Kuva nimi={p.data.kuva} variantti="kortti" />
                ) : (
                  <span class="kuvaton" aria-hidden="true">
                    <Icon name={p.data.ikoni} size={48} />
                  </span>
                )}
              </span>
              <span class="muu-teksti">
                <strong>{p.data.nimi}</strong>
                <span>{p.data.kortti}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section--sand" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>

  <section class="section" id="meista" aria-labelledby="meista-otsikko">
    <div class="container meista">
      <h2 id="meista-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
      <p class="meista-lause reveal">
        Olemme suomalainen perheyritys pääkaupunkiseudulta. {yritys.kokemusLause} Asiakkaan tarpeet ovat meille
        ensisijaisia, ja muokkaamme työn sinun kohteesi mukaan.
      </p>
    </div>
  </section>

  <section class="section section--sand" id="ukk" aria-labelledby="ukk-otsikko">
    <div class="container ukk-ruudukko">
      <div class="ukk-otsake">
        <h2 id="ukk-otsikko">Usein kysyttyä</h2>
        <p>Etkö löytänyt vastausta? Kysy meiltä suoraan.</p>
        <a href="/yhteystiedot/" class="btn btn--secondary">Ota yhteyttä</a>
      </div>
      <Ukk kysymykset={ukk} />
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<script>
  // Karusellin nuolinapit vierittävät yhden kortin verran
  const lista = document.querySelector<HTMLElement>('[data-karuselli]');
  const siirto = (suunta: number) => {
    if (!lista) return;
    const kortti = lista.querySelector('li');
    const leveys = kortti ? kortti.getBoundingClientRect().width + 16 : 320;
    lista.scrollBy({ left: suunta * leveys, behavior: 'smooth' });
  };
  document.querySelector('[data-karuselli-edellinen]')?.addEventListener('click', () => siirto(-1));
  document.querySelector('[data-karuselli-seuraava]')?.addEventListener('click', () => siirto(1));
</script>

<style>
  /* Hero: otsikko vasemmalla, neliövideo oikealla */
  .hero { padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); }
  .hero-ruudukko { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: center; }
  @media (min-width: 64rem) {
    .hero-ruudukko { grid-template-columns: 7fr 5fr; }
  }
  .hero-teksti { display: grid; gap: 1.75rem; justify-items: start; }
  .hero-lead { max-width: 30rem; font-size: var(--fs-lg); line-height: 1.5; color: var(--muted); }

  /* Kolme lupausta */
  .lupaukset-osio { border-top: 1px solid var(--line); }
  .lupaukset {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem clamp(2rem, 4vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .lupaukset li { display: grid; gap: 0.4rem; align-content: start; }
  .lupaukset strong { color: var(--ink); font-weight: 560; font-size: 1.25rem; letter-spacing: -0.015em; line-height: 1.3; }
  .lupaukset p { color: var(--muted); }

  /* Huoltovälit */
  .huolto { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 64rem) {
    .huolto { grid-template-columns: 5fr 7fr; }
    .huolto-otsake { position: sticky; top: calc(var(--header-offset) + 2rem); }
  }
  .huolto-otsake { display: grid; gap: 1rem; }
  .huolto-otsake p { color: var(--muted); font-size: var(--fs-lg); max-width: 30rem; }

  /* Karuselli */
  .karuselli-otsake { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; }
  .karuselli-napit { display: none; gap: 0.5rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 48rem) and (hover: hover) {
    .karuselli-napit { display: flex; }
  }
  .pyorea {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 200ms ease, transform 150ms var(--ease-out);
  }
  .pyorea:hover { background: var(--sand); }
  .pyorea:active { transform: scale(0.94); }
  .pyorea :global(.kaannetty) { transform: scaleX(-1); }
  .karuselli {
    list-style: none;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80vw, 24rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2)) 1rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .karuselli::-webkit-scrollbar { display: none; }
  .karuselli li { scroll-snap-align: start; display: grid; }
  .muu { display: grid; gap: 1rem; align-content: start; color: var(--ink); text-decoration: none; }
  .muu-kuva { display: block; border-radius: var(--r-md); overflow: hidden; }
  .muu-kuva :global(.kuvapaikka) { border-radius: 0; }
  .muu :global(img) { transition: transform 600ms var(--ease-out); }
  .kuvaton { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--green-fill); color: var(--green-text-on); }
  .muu-teksti { display: grid; gap: 0.3rem; padding-inline: 0.25rem; }
  .muu strong { font-size: 1.25rem; font-weight: 560; letter-spacing: -0.015em; }
  .muu-teksti > span { color: var(--muted); }
  @media (hover: hover) and (pointer: fine) {
    .muu:hover :global(img) { transform: scale(1.03); }
  }

  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }

  /* Meistä */
  .meista { display: grid; gap: 1.5rem; }
  .meista > * { max-width: 56rem; }
  .meista-lause {
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
    line-height: 1.3;
    font-weight: 450;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Usein kysyttyä */
  .ukk-ruudukko { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 64rem) {
    .ukk-ruudukko { grid-template-columns: 5fr 7fr; }
  }
  .ukk-otsake { display: grid; gap: 1rem; justify-items: start; }
  .ukk-otsake p { color: var(--muted); font-size: var(--fs-lg); }
</style>
