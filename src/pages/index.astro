---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import HeroLead from '../components/HeroLead.astro';
import Bento from '../components/Bento.astro';
import PalveluKaruselli from '../components/PalveluKaruselli.astro';
import TyoVaiheet from '../components/TyoVaiheet.astro';
import Galleria from '../components/Galleria.astro';
import Huoltovalit from '../components/Huoltovalit.astro';
import Ukk from '../components/Ukk.astro';
import CtaOsio from '../components/CtaOsio.astro';
import yritys from '../data/yritys.json';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;

// Etusivulle vain ensimmäinen lause, koko teksti on palvelusivulla
const ekaLause = (t: string) => {
  const i = t.indexOf('. ');
  return i === -1 ? t : t.slice(0, i + 1);
};

const lupaukset = [
  { nimi: 'Ilmainen', vaite: 'Kuntoarvio paikan päällä', teksti: 'Saat selkeän suunnitelman ja hinnan ilman sitoutumista.' },
  { nimi: 'Kiinteä', vaite: 'Hinta ennen aloitusta', teksti: 'Saat kiinteän hinnan kuntoarvion jälkeen, ja päätät itse, jatketaanko.' },
  { nimi: 'Siisti', vaite: 'Työmaa kuntoon lopuksi', teksti: 'Tarkistamme tuloksen kanssasi ja kierrätämme jätteet.' },
];

type Solu = { otsikko: string; teksti?: string; href?: string };

const kattoSolut: Solu[] = [
  ...katot.data.alapalvelut.map((a) => ({ otsikko: a.nimi, teksti: ekaLause(a.teksti) })),
  { otsikko: 'Lue lisää kattotöistä', href: '/palvelut/katot/' },
];

// Vanhan sivun kattosisällöstä
const merkit: Solu[] = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
].map((m) => ({ otsikko: m }));
merkit.push({ otsikko: 'Huomasitko jonkin näistä? Ota yhteyttä', href: '/yhteystiedot/' });

const maalausSolut: Solu[] = [
  ...maalaus.data.alapalvelut.map((a) => ({ otsikko: a.nimi, teksti: a.teksti })),
  { otsikko: 'Lue lisää talon maalauksesta', href: '/palvelut/maalaus/' },
];

const ukk = [...katot.data.ukk, ...maalaus.data.ukk].slice(0, 6);
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys, ilmainen kuntoarvio."
>
  <HeroLead rivit={['Katto\u00ADremontit', 'ja maalaus', 'omakotitaloille pääkaupunkiseudulla']} kohdat={lupaukset} />

  <section data-theme="light-grey" id="palvelut" aria-labelledby="palvelut-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="palvelut-otsikko" data-fit>Katot ja seinät</h2>
        <p>Erikoisalaamme ovat kattoremontit ja maalaus. Hoidamme samalla myös muut omakotitalon ulkotyöt.</p>
      </div>
    </div>
    <PalveluKaruselli />
  </section>

  <section data-theme="birch" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="katot-otsikko" data-fit>Kaikki kattotyöt</h2>
        <p>{ekaLause(katot.data.ingressi)} {yritys.kokemusLause}</p>
      </div>
      <Bento kuva="katot" solut={kattoSolut} korostus={5} />
    </div>
  </section>

  <section data-theme="oliivi" aria-labelledby="merkit-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="merkit-otsikko" data-fit>Katon merkit</h2>
        <p>Mistä tiedät, että katto tarvitsee huoltoa? Tikkaille ei tarvitse kiivetä itse.</p>
      </div>
      <Bento kuva="katto-huolto" solut={merkit} korostus={5} />
    </div>
  </section>

  <section data-theme="asphalt" aria-labelledby="huolto-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="huolto-otsikko" data-fit>Huoltovälit</h2>
        <p>Milloin katto ja seinät kannattaa maalata? Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
      </div>
      <Huoltovalit />
    </div>
  </section>

  <section data-theme="light-grey" aria-labelledby="maalaus-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="maalaus-otsikko" data-fit>Talon maalaus</h2>
        <p>{maalaus.data.ingressi}</p>
      </div>
      <Bento kuva="maalaus" solut={maalausSolut} korostus={3} />
    </div>
  </section>

  <section data-theme="birch" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="vaiheet-otsikko" data-fit>Näin työ etenee</h2>
        <p>Kolme vaihetta yhteydenotosta valmiiseen työhön.</p>
      </div>
      <TyoVaiheet />
    </div>
  </section>

  <section data-theme="light-grey" aria-labelledby="galleria-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="galleria-otsikko" data-fit>Katot ja pihat</h2>
        <p>{yritys.palvelualue.join(', ')}. Tulemme kohteeseen ja teemme työn alusta loppuun.</p>
      </div>
    </div>
    <Galleria />
  </section>

  <section data-theme="birch" id="meista" aria-labelledby="meista-otsikko">
    <div class="container meista">
      <div class="meista-kuva">
        <Kuva nimi="perheyritys" vara={['etusivu-mobiili', 'etusivu']} variantti="tayta" />
      </div>
      <div class="meista-teksti">
        <p class="eyebrow">Meistä</p>
        <h2 id="meista-otsikko" data-fit>Perheyritys</h2>
        <p class="meista-lause">
          Olemme suomalainen perheyritys pääkaupunkiseudulta. {yritys.kokemusLause} Asiakkaan tarpeet ovat meille
          ensisijaisia, ja muokkaamme työn sinun kohteesi mukaan.
        </p>
        <p class="meista-tiedot">{yritys.nimi}, Y-tunnus {yritys.ytunnus}, {yritys.kaupunki}</p>
      </div>
    </div>
  </section>

  <section data-theme="metsa" id="ukk" aria-labelledby="ukk-otsikko">
    <div class="container ukk-ruudukko">
      <div class="ukk-otsake">
        <h2 id="ukk-otsikko" data-fit>Kysymyksiä</h2>
        <p>Etkö löytänyt vastausta? Kysy meiltä suoraan.</p>
        <a href="/yhteystiedot/" class="btn">Ota yhteyttä</a>
      </div>
      <Ukk kysymykset={ukk} />
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  [data-theme='oliivi'] { --korostus: var(--p-asphalt); }

  /* Meistä: kuva ja sisältö rinnakkain */
  .meista { display: grid; gap: var(--section-gap); align-items: center; }
  @media (min-width: 1025px) {
    .meista { grid-template-columns: 1fr 1fr; }
  }
  .meista-kuva { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-md); overflow: hidden; }
  @media (min-width: 768px) and (max-width: 1024px) {
    .meista-kuva { aspect-ratio: 4 / 3; }
  }
  .meista-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
  .meista-teksti { display: grid; gap: 24px; justify-items: start; }
  .meista-lause {
    font-family: var(--font-display);
    font-stretch: var(--stretch);
    font-weight: 500;
    letter-spacing: 0.3px;
    font-size: clamp(22px, 1rem + 1vw, 32px);
    line-height: 1.15;
    color: var(--ink);
  }
  .meista-tiedot { color: var(--muted); font-size: 16px; }

  /* Kysymyksiä: otsikko ja nappi vasemmalla, haitari oikealla */
  .ukk-ruudukko { display: grid; gap: var(--section-gap); }
  @media (min-width: 1025px) {
    .ukk-ruudukko { grid-template-columns: 1fr 1.4fr; align-items: start; }
  }
  .ukk-otsake { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  @media (min-width: 1025px) {
    .ukk-otsake { align-items: flex-start; text-align: left; }
  }
  .ukk-otsake p { color: var(--muted); font-weight: 600; font-size: clamp(18px, 1rem + 0.4vw, 24px); }
</style>
