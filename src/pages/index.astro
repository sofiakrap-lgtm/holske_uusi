---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import Vaiheet from '../components/Vaiheet.astro';
import CtaOsio from '../components/CtaOsio.astro';
import Huoltovalit from '../components/Huoltovalit.astro';
import { getKuva } from '../lib/kuvat';
import yritys from '../data/yritys.json';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const muut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const tel = `tel:${yritys.puhelinE164}`;
const heroKuva = getKuva('etusivu');
const kattoKuva = getKuva('katot');
const huoltoKuva = getKuva('katto-huolto');
const maalausKuva = getKuva('maalaus');

// Vanhan sivun kattosisällöstä
const merkit = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
];
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys, ilmainen kuntoarvio."
>
  <section class:list={['hero', { 'hero--kuva': heroKuva }]}>
    {
      heroKuva && (
        <div class="hero-tausta">
          <Kuva nimi="etusivu" variantti="tayta" eager />
        </div>
      )
    }
    <div class="container hero-sisus">
      <h1>Kattoremontit ja katon maalaus</h1>
      <p class="hero-lead">
        Pieni perheyritys pääkaupunkiseudulta. Kunnostamme, maalaamme ja pinnoitamme omakotitalojen katot ja seinät
        kiinteään hintaan.
      </p>
      <div class="hero-toiminnot">
        <a href={tel} class="btn"><Icon name="puhelin" size={20} /> Soita {yritys.puhelinNaytto}</a>
        <a href={`mailto:${yritys.sahkoposti}`} class="hero-sposti">{yritys.sahkoposti}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class:list={['bento', { 'bento--kuva': kattoKuva }]}>
        <div class="solu solu--esittely">
          <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
          <p>{katot.data.ingressi}</p>
          <a href="/palvelut/katot/" class="link-arrow">Lue lisää kattotöistä <Icon name="nuoli" size={18} /></a>
        </div>
        {
          kattoKuva && (
            <div class="solu solu--kuva">
              <Kuva nimi="katot" variantti="tayta" />
            </div>
          )
        }
        {
          katot.data.alapalvelut.map((a, i) => (
            <div class:list={['solu', 'solu--palvelu', `solu--p${i + 1}`]}>
              <h3>{a.nimi}</h3>
              <p>{a.teksti}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section merkit-osio" aria-labelledby="merkit-otsikko">
    <div class:list={['container', 'merkit-ruudukko', { 'merkit-ruudukko--kuva': huoltoKuva }]}>
      {huoltoKuva && <Kuva nimi="katto-huolto" variantti="jaettu" class="reveal" />}
      <div class="merkit-teksti">
        <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
        <p class="lead">Tikkaille ei tarvitse kiivetä itse. Kun huomaat jonkin näistä, on hyvä aika soittaa.</p>
        <ul class="merkit">
          {
            merkit.map((m) => (
              <li>
                <Icon name="check" size={22} />
                <span>{m}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="huolto-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
        <p>Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
      </div>
      <Huoltovalit />
    </div>
  </section>

  <section class="section" aria-labelledby="maalaus-otsikko">
    <div class:list={['container', 'maalaus', { 'maalaus--kuva': maalausKuva }]}>
      <div class="maalaus-teksti">
        <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
        <p class="lead">{maalaus.data.ingressi}</p>
        <ul class="alapalvelut">
          {
            maalaus.data.alapalvelut.map((a) => (
              <li>
                <h3>{a.nimi}</h3>
                <p>{a.teksti}</p>
              </li>
            ))
          }
        </ul>
        <a href="/palvelut/maalaus/" class="link-arrow">Lue lisää talon maalauksesta <Icon name="nuoli" size={18} /></a>
      </div>
      {maalausKuva && <Kuva nimi="maalaus" variantti="jaettu" class="reveal" />}
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="muut-otsikko">
    <div class="container">
      <h2 id="muut-otsikko" class="osion-otsikko">Myös nämä hoituvat</h2>
      <ul class="muut">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`} class="muu">
                {getKuva(p.data.kuva) && <Kuva nimi={p.data.kuva} variantti="kortti" />}
                <span class="muu-teksti">
                  <strong>
                    {p.data.nimi} <Icon name="nuoli" size={20} />
                  </strong>
                  <span>{p.data.kortti}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section meista" id="meista" aria-labelledby="meista-otsikko">
    <div class="container meista-sisus">
      <h2 id="meista-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
      <p class="meista-lause">
        Olemme suomalainen perheyritys pääkaupunkiseudulta. {yritys.kokemusLause} Asiakkaan tarpeet ovat meille
        ensisijaisia, ja muokkaamme työn sinun kohteesi mukaan.
      </p>
      <p class="meista-tiedot">
        {yritys.nimi}, Y-tunnus {yritys.ytunnus}, {yritys.katuosoite}, {yritys.postinumero} {yritys.kaupunki}
      </p>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  /* 1. Hero */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(88svh, 52rem);
    padding-block: clamp(6rem, 12vw, 8rem) clamp(2.5rem, 6vw, 4.5rem);
    background: var(--green-fill);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-tausta { position: absolute; inset: 0; z-index: -1; }
  .hero-tausta :global(.kuvapaikka) { border-radius: 0; height: 100%; min-height: 0; }
  .hero--kuva::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(10 20 14 / 0.82) 0%, rgb(10 20 14 / 0.45) 45%, rgb(10 20 14 / 0) 75%),
      linear-gradient(to right, rgb(10 20 14 / 0.45), rgb(10 20 14 / 0) 60%);
  }
  @media (max-width: 48rem) {
    .hero--kuva::before {
      background: linear-gradient(to top, rgb(10 20 14 / 0.9) 0%, rgb(10 20 14 / 0.7) 55%, rgb(10 20 14 / 0.25) 100%);
    }
  }
  .hero-sisus { display: grid; gap: 1.25rem; justify-items: start; }
  .hero h1 { color: #fff; max-width: 13ch; }
  .hero-lead { max-width: 34rem; font-size: var(--fs-lg); line-height: 1.5; color: rgb(255 255 255 / 0.9); }
  .hero-toiminnot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; margin-top: 0.75rem; }
  .hero-sposti {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 600;
    font-size: var(--fs-lg);
    color: #fff;
  }
  .hero :focus-visible { outline-color: var(--orange); }

  /* 2. Bento */
  .bento { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .solu {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .solu p { color: var(--muted); }
  .solu--esittely { background: var(--green-fill); color: var(--green-text-on); box-shadow: none; gap: 1.1rem; }
  .solu--esittely h2 { color: #fff; font-size: clamp(1.85rem, 1.4rem + 1.4vw, 2.5rem); }
  .solu--esittely p { color: var(--green-text-on); }
  .solu--esittely .link-arrow { color: #fff; margin-top: 0.5rem; }
  .solu--esittely :focus-visible { outline-color: var(--orange); }
  .solu--kuva { padding: 0; overflow: hidden; box-shadow: none; }
  .solu--p2, .solu--p4 { background: var(--sand); box-shadow: none; }
  @media (min-width: 48rem) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .solu--esittely { grid-column: 1 / -1; }
    .solu--p1, .solu--p2, .solu--p3 { grid-column: span 2; }
    .solu--p4, .solu--p5 { grid-column: span 3; }
  }
  @media (min-width: 64rem) {
    .bento--kuva { grid-template-columns: repeat(6, 1fr); }
    .bento--kuva .solu--esittely { grid-column: 1 / 3; grid-row: 1 / 3; align-content: end; }
    .bento--kuva .solu--kuva { grid-column: 3 / -1; grid-row: 1; min-height: 22rem; }
    .bento--kuva .solu--p1 { grid-column: 3 / 5; grid-row: 2; }
    .bento--kuva .solu--p2 { grid-column: 5 / -1; grid-row: 2; }
    .bento--kuva .solu--p3,
    .bento--kuva .solu--p4,
    .bento--kuva .solu--p5 { grid-column: span 2; }
  }

  /* 3. Merkit */
  .merkit-ruudukko { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  @media (min-width: 60rem) {
    .merkit-ruudukko--kuva { grid-template-columns: 5fr 6fr; }
  }
  .merkit-teksti { display: grid; gap: 1.25rem; max-width: 40rem; }
  .merkit { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .merkit li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: center;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 600;
    color: var(--ink);
  }
  .merkit :global(.icon) {
    box-sizing: content-box;
    padding: 0.45rem;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--green) 12%, transparent);
    color: var(--green);
  }

  /* 4. Huoltovälit */
  .osio-otsake { display: grid; gap: 1rem; max-width: 44rem; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .osio-otsake p { color: var(--muted); }

  /* 5. Maalaus */
  .maalaus { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  @media (min-width: 60rem) {
    .maalaus--kuva { grid-template-columns: 6fr 5fr; }
  }
  .maalaus-teksti { display: grid; gap: 1.25rem; justify-items: start; }
  .alapalvelut {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .alapalvelut li { display: grid; gap: 0.35rem; align-content: start; }
  .alapalvelut h3 { font-size: 1.15rem; }
  .alapalvelut p { color: var(--muted); }

  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }

  /* 7. Muut palvelut */
  .muut {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
  }
  .muu {
    display: grid;
    height: 100%;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .muu :global(.kuvapaikka) { border-radius: 0; }
  .muu :global(img) { transition: transform 600ms var(--ease-out); }
  .muu-teksti { display: grid; gap: 0.4rem; align-content: start; padding: 1.4rem 1.5rem 1.6rem; }
  .muu strong {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.2rem;
    font-weight: 650;
    color: var(--green);
  }
  .muu strong :global(.icon) { flex: none; transition: transform 300ms var(--ease-out); }
  .muu-teksti > span { color: var(--muted); }
  @media (hover: hover) and (pointer: fine) {
    .muu:hover { transform: translateY(-3px); }
    .muu:hover :global(img) { transform: scale(1.03); }
    .muu:hover strong :global(.icon) { transform: translateX(4px); }
  }

  /* 8. Meistä */
  .meista { padding-bottom: 0; }
  .meista-sisus { display: grid; gap: 1.5rem; }
  .meista-sisus > * { max-width: 60rem; }
  .meista-lause {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.05rem + 1.2vw, 2rem);
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .meista-tiedot { color: var(--muted); font-size: var(--fs-sm); }
</style>
