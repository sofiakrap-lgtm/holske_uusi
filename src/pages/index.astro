---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import Edut from '../components/Edut.astro';
import Vaiheet from '../components/Vaiheet.astro';
import CtaOsio from '../components/CtaOsio.astro';
import yritys from '../data/yritys.json';
import etusivu from '../data/etusivu.json';
import hinnasto from '../data/hinnasto.json';
const kv = hinnasto.kotitalousvahennys;

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const lisapalvelut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort(
  (a, b) => a.data.jarjestys - b.data.jarjestys,
);
const tel = `tel:${yritys.puhelin.replace(/\s/g, '')}`;

// Merkit ja huoltovälit vanhan sivuston katto- ja maalaussisällöstä
const merkit = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
];
const huoltovalit = [
  { kohde: 'Uusi sinkitty peltikatto', vali: 'Ensimmäinen maalaus 2-3 vuoden kuluttua' },
  { kohde: 'Maalattu peltikatto', vali: 'Uusi maalaus 15-20 vuoden välein' },
  { kohde: 'Betonitiilikatto', vali: 'Pinnoitus, kun katto on 20-30 vuotta vanha' },
  { kohde: 'Puutalon ulkoseinät', vali: 'Uusi maalaus 5-10 vuoden välein' },
];
---

<BaseLayout
  title="Kattoremontit ja katon maalaus | Vantaa, Espoo, Helsinki | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille pääkaupunkiseudulla. Perheyritys, yli 25 vuoden kokemus, kiinteä hinta. Ilmainen kuntoarvio."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="eyebrow">Kattoremontit ja maalaus pääkaupunkiseudulla</span>
        <h1>Katon maalaus ja kattoremontit omakotitaloille</h1>
        <p class="lead">
          Kunnostamme, maalaamme ja pinnoitamme tiili-, pelti- ja huopakatot siististi ja kiinteään hintaan. Pieni
          perheyritys, yli 25 vuoden kokemus.
        </p>
        <ul class="chipit" aria-label="Kattotyypit">
          <li>Tiilikatot</li>
          <li>Peltikatot</li>
          <li>Huopakatot</li>
        </ul>
        <div class="btn-row">
          <a href="/kuntoarvio/?palvelu=katot" class="btn">Varaa ilmainen katon kuntoarvio <Icon name="nuoli" size={20} /></a>
          <a href={tel} class="btn btn--secondary"><Icon name="puhelin" size={20} /> {yritys.puhelinNaytto}</a>
        </div>
        <p class="hero-note"><Icon name="check" size={18} /> {yritys.vastausaika}. Kuntoarvio ei sido mihinkään.</p>
      </div>
      <div class="hero-media">
        <Kuva
          nimi="etusivu"
          alt="Omakotitalo, jonka katto on juuri maalattu"
          ikoni="katto"
          eager
          suhde="4 / 5"
          sizes="(min-width: 60rem) 45vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section--tight edut-osio" aria-label="Miksi Holske">
    <div class="container">
      <Edut />
    </div>
  </section>

  <section class="section" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kattopalvelut</span>
        <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
        <p class="lead">
          Tunnemme eri katemateriaalit ja toteutustavat. Työ tehdään siististi, laadukkaasti ja kiinteään hintaan.
        </p>
      </div>
      <ul class="kattokortit">
        {
          katot.data.alapalvelut.map((a) => (
            <li>
              <span class="kk-ikoni"><Icon name="katto" size={26} /></span>
              <h3>{a.nimi}</h3>
              <p>{a.teksti}</p>
            </li>
          ))
        }
        <li class="kattokortti-linkki">
          <a href="/palvelut/katot/" class="kk-linkki">
            <span>Lue lisää kattopalveluista</span>
            <Icon name="nuoli" size={24} />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="merkit-otsikko">
    <div class="container split">
      <Kuva nimi="katto-huolto" alt="Peltikaton maalaus käynnissä" ikoni="katto" suhde="5 / 4" />
      <div class="prose">
        <span class="eyebrow">Katon kunto</span>
        <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
        <p>Tikkaille ei tarvitse kiivetä itse. Nämä merkit kertovat, että huolto tai remontti voi olla ajankohtainen:</p>
        <ul class="merkit">
          {merkit.map((m) => <li><Icon name="check" size={20} /> {m}</li>)}
        </ul>
        <p>Ilmaisessa kuntoarviossa selvitämme katon tilanteen puolestasi. Saat selkeän suunnitelman ja kiinteän hinnan ilman sitoutumista.</p>
        <div class="btn-row">
          <a href="/kuntoarvio/?palvelu=katot" class="btn">Pyydä katon kuntoarvio</a>
          <a href="/hintalaskuri/" class="btn btn--secondary">Laske katon hinta</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="huolto-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Huoltovälit</span>
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
      </div>
      <dl class="huoltovalit">
        {
          huoltovalit.map((h) => (
            <div>
              <dt>{h.kohde}</dt>
              <dd>{h.vali}</dd>
            </div>
          ))
        }
      </dl>
      <p class="huomio">Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="maalaus-otsikko">
    <div class="container split split--reverse">
      <Kuva nimi="maalaus" alt="Puutalon seinää maalataan siveltimellä" ikoni="maalaus" suhde="5 / 4" />
      <div class="prose">
        <span class="eyebrow">Maalaus</span>
        <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
        <p>{maalaus.data.ingressi}</p>
        <p>
          Maalaamme rakennuksen yhteen tai kahteen kertaan pinnan kunnon mukaan. Lopuksi tarkistamme työn kanssasi,
          siivoamme työmaan ja kierrätämme jätteet asianmukaisesti.
        </p>
        <a href="/palvelut/maalaus/" class="link-arrow">Talon maalaus <Icon name="nuoli" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section section--green" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Näin se toimii</span>
        <h2 id="vaiheet-otsikko">Kolme askelta valmiiseen kattoon</h2>
      </div>
      <Vaiheet />
    </div>
  </section>

  <section class="section" aria-labelledby="perhe-otsikko">
    <div class="container split">
      <Kuva nimi="perheyritys" alt="Holsken tiimi työmaalla" ikoni="perhe" suhde="5 / 4" />
      <div class="prose">
        <span class="eyebrow">Meistä</span>
        <h2 id="perhe-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
        <p>
          Perhekeskeisyys on tärkeimpiä arvojamme, ja se auttaa meitä tekemään työmme tehokkaasti. Luotamme toisiimme ja
          teemme kaiken sujuvalla yhteistyöllä.
        </p>
        <p>Asiakkaan tarpeet ovat meille ensisijaisia. Muokkaamme palvelun sinun kohteesi mukaan.</p>
        <a href="/meista/" class="link-arrow">Tutustu meihin <Icon name="nuoli" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section--tight lisat" aria-labelledby="lisat-otsikko">
    <div class="container">
      <div class="lisat-otsikko">
        <h2 id="lisat-otsikko">Myös nämä hoituvat</h2>
        <a href="/palvelut/" class="link-arrow">Kaikki palvelut <Icon name="nuoli" size={18} /></a>
      </div>
      <ul class="lisalista">
        {
          lisapalvelut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`}>
                <Icon name={p.data.ikoni} size={26} />
                <span class="lisa-teksti">
                  <strong>
                    {p.data.nimi}
                    {etusivu.nosto === p.id && <span class="sesonki">Sesonki nyt</span>}
                  </strong>
                  <span>{p.data.kortti}</span>
                </span>
                <Icon name="nuoli" size={20} />
              </a>
            </li>
          ))
        }
        <li>
          <a href="/palvelut/#muut-korjaukset">
            <Icon name="korjaus" size={26} />
            <span class="lisa-teksti">
              <strong>Muut korjaustyöt</strong>
              <span>Julkisivun korjaukset ja muut ulkotyöt. Aina neuvoteltavissa.</span>
            </span>
            <Icon name="nuoli" size={20} />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-label="Hinta ja palvelualue">
    <div class="container infot">
      <article class="info">
        <Icon name="laskin" size={32} />
        <h2>Mitä katon maalaus maksaa?</h2>
        <p>Hinta riippuu katon koosta, materiaalista ja kunnosta. Hintalaskurilla saat suuntaa ja voit lähettää tiedot suoraan meille.</p>
        <a href="/hintalaskuri/" class="link-arrow">Hintalaskuriin <Icon name="nuoli" size={18} /></a>
      </article>
      <article class="info">
        <Icon name="vahennys" size={32} />
        <h2>Kotitalousvähennys</h2>
        <p>Vuosina {kv.vuodet} vähennys on {kv.prosentti} % työn osuudesta, enintään {kv.enimmaismaara.toLocaleString('fi-FI')} € henkilöä kohden. Omavastuu on {kv.omavastuu} €. Puolisot voivat kumpikin tehdä oman vähennyksensä.</p>
        <a href="https://www.vero.fi/henkiloasiakkaat/verokortti-ja-veroilmoitus/tulot-ja-vahennykset/kotitalousvahennys/" class="link-arrow" rel="noopener" target="_blank">Kotitalousvähennys vero.fi:ssä <Icon name="nuoli" size={18} /></a>
      </article>
      <article class="info">
        <Icon name="paikallinen" size={32} />
        <h2>Palvelualue</h2>
        <p>Teemme kattotöitä koko pääkaupunkiseudulla: {yritys.palvelualue.join(', ')}. Kotipaikkamme on Vantaa.</p>
        <a href="/yhteystiedot/" class="link-arrow">Yhteystiedot <Icon name="nuoli" size={18} /></a>
      </article>
    </div>
  </section>

  <CtaOsio otsikko="Varaa ilmainen katon kuntoarvio" palvelu="katot" />
</BaseLayout>

<style>
  .hero { padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero-grid { grid-template-columns: 1.1fr 0.9fr; }
  }
  .hero-text {
    display: grid;
    gap: 1.4rem;
    min-width: 0;
  }
  .chipit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chipit li {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--moss-soft);
    color: var(--green);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .hero-text .btn-row { margin-top: 0.25rem; }
  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero-note :global(.icon) { color: var(--ok); flex: none; }
  .hero-media { min-width: 0; }
  @media (max-width: 59.99rem) {
    .hero-media :global(.kuva) { aspect-ratio: 4 / 3 !important; }
  }

  .edut-osio {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .kattokortit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  @media (min-width: 64rem) {
    .kattokortit { grid-template-columns: repeat(3, 1fr); }
  }
  .kattokortit > li:not(.kattokortti-linkki) {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .kk-ikoni {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--moss-soft);
    color: var(--green);
    margin-bottom: 0.4rem;
  }
  .kattokortit h3 { font-size: 1.25rem; }
  .kattokortit p { color: var(--muted); font-size: 1.0625rem; }
  .kk-linkki {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    min-height: 10rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--green);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.15;
    text-decoration: none;
    transition: transform 240ms var(--ease-out), background-color 200ms ease;
  }
  .kk-linkki:hover { background: var(--green-deep); }
  .kk-linkki:active { transform: scale(0.985); }
  .kk-linkki :global(.icon) { flex: none; color: var(--orange); transition: transform 220ms var(--ease-out); }
  .kk-linkki:hover :global(.icon) { transform: translateX(4px); }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .split { grid-template-columns: 1fr 1fr; }
    .split--reverse > :first-child { order: 2; }
  }
  .split .prose { min-width: 0; }
  .merkit {
    list-style: none;
    padding: 0 !important;
    display: grid;
    gap: 0.6rem !important;
  }
  .merkit li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-weight: 500;
  }
  .merkit :global(.icon) { flex: none; color: var(--ok); margin-top: 0.2rem; }

  .huoltovalit {
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .huoltovalit div {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    border-top: 3px solid var(--orange);
    background: var(--surface);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }
  .huoltovalit dt { font-weight: 600; color: var(--green); font-size: 1.125rem; }
  .huoltovalit dd { margin: 0; color: var(--muted); }
  .huomio { margin-top: 1.5rem; color: var(--muted); }

  .lisat { border-top: 1px solid var(--line); }
  .lisat-otsikko {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .lisat-otsikko h2 { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem); }
  .lisalista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .lisalista a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 160ms ease, transform 200ms var(--ease-out);
  }
  .lisalista a:hover { border-color: color-mix(in srgb, var(--green) 35%, var(--line)); }
  .lisalista a:active { transform: scale(0.985); }
  .lisalista a > :global(.icon:first-child) { color: var(--green); }
  .lisalista a > :global(.icon:last-child) { color: var(--muted); }
  .lisa-teksti { display: grid; gap: 0.15rem; min-width: 0; }
  .lisa-teksti strong { color: var(--green); display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .lisa-teksti > span { color: var(--muted); font-size: 0.9375rem; }
  .sesonki {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--orange) 22%, transparent);
    color: #6b3d05;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .infot {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .info {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 2rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .info :global(.icon) { color: var(--orange); }
  .info h2 { font-family: var(--font-body); font-weight: 600; font-size: 1.375rem; letter-spacing: 0; }
  .info p { color: var(--muted); font-size: 1.0625rem; }
</style>
