---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import Edut from '../components/Edut.astro';
import Vaiheet from '../components/Vaiheet.astro';
import CtaOsio from '../components/CtaOsio.astro';
import yritys from '../data/yritys.json';
import etusivu from '../data/etusivu.json';
import { kvTila, kvLuvut, kv } from '../lib/kv-teksti';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const lisapalvelut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort(
  (a, b) => a.data.jarjestys - b.data.jarjestys,
);
const tel = `tel:${yritys.puhelinE164}`;

// Merkit ja huoltovälit vanhan sivuston katto- ja maalaussisällöstä
const merkit = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
];
const huoltovalit = [
  { kohde: 'Uusi sinkitty peltikatto', vali: 'Ensimmäinen maalaus 2-3 vuoden kuluttua' },
  { kohde: 'Maalattu peltikatto', vali: 'Uusi maalaus 15-20 vuoden välein' },
  { kohde: 'Betonitiilikatto', vali: 'Pinnoitus, kun katto on 20-30 vuotta vanha' },
  { kohde: 'Puutalon ulkoseinät', vali: 'Uusi maalaus 5-10 vuoden välein' },
];
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys. Varaa ilmainen kuntoarvio."
>
  <section class="hero">
    <div class="container hero-text">
      <span class="eyebrow">Kattoremontit ja maalaus pääkaupunkiseudulla</span>
      <h1>Katon maalaus ja kattoremontit omakotitaloille</h1>
      <p class="lead">
        Kunnostamme, maalaamme ja pinnoitamme tiili-, pelti- ja huopakatot siististi ja kiinteään hintaan. Pieni
        perheyritys, tekijöillä yli 25 vuoden kokemus.
      </p>
      <div class="btn-row">
        <a href="/kuntoarvio/?palvelu=katot" class="btn">Varaa ilmainen katon kuntoarvio <Icon name="nuoli" size={20} /></a>
        <a href={tel} class="btn btn--secondary"><Icon name="puhelin" size={20} /> {yritys.puhelinNaytto}</a>
      </div>
      <p class="hero-yhteys">
        <span><Icon name="check" size={18} /> {yritys.vastausaika}</span>
        <a href={`mailto:${yritys.sahkoposti}`}><Icon name="sahkoposti" size={18} /> {yritys.sahkoposti}</a>
      </p>
    </div>
    <div class="hero-kuva">
      <Kuva nimi="etusivu" ikoni="katto" variantti="hero" eager />
    </div>
  </section>

  <section class="section--tight edut-osio" aria-label="Miksi Holske">
    <div class="container">
      <Edut />
    </div>
  </section>

  <section class="section" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kattopalvelut</span>
        <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
        <p class="lead">
          Tunnemme eri katemateriaalit ja toteutustavat. Työ tehdään siististi, laadukkaasti ja kiinteään hintaan.
        </p>
      </div>
      <ul class="kattokortit">
        {
          katot.data.alapalvelut.map((a) => (
            <li>
              <span class="kk-ikoni"><Icon name="katto" size={26} /></span>
              <h3>{a.nimi}</h3>
              <p>{a.teksti}</p>
            </li>
          ))
        }
        <li class="kattokortti-linkki">
          <a href="/palvelut/katot/" class="kk-linkki">
            <span>Lue lisää kattopalveluista</span>
            <Icon name="nuoli" size={24} />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--sand kuvaosio" aria-labelledby="merkit-otsikko">
    <div class="container osio-otsake">
      <span class="eyebrow">Katon kunto</span>
      <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
      <p class="lead">Tikkaille ei tarvitse kiivetä itse. Ilmaisessa kuntoarviossa selvitämme katon tilanteen puolestasi.</p>
    </div>
    <div class="reveal">
      <Kuva nimi="katto-huolto" ikoni="katto" variantti="leveä" />
    </div>
    <div class="container merkit-rivi">
      <ul class="merkit">
        {merkit.map((m) => <li><Icon name="check" size={20} /> {m}</li>)}
      </ul>
      <div class="merkit-cta">
        <p>Saat selkeän suunnitelman ja kiinteän hinnan ilman sitoutumista.</p>
        <div class="btn-row">
          <a href="/kuntoarvio/?palvelu=katot" class="btn">Pyydä katon kuntoarvio</a>
          <a href="/hintalaskuri/" class="btn btn--secondary">Laske katon hinta</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="huolto-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Huoltovälit</span>
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
      </div>
      <dl class="huoltovalit">
        {
          huoltovalit.map((h) => (
            <div>
              <dt>{h.kohde}</dt>
              <dd>{h.vali}</dd>
            </div>
          ))
        }
      </dl>
      <p class="huomio">Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
    </div>
  </section>

  <section class="section kuvaosio" aria-labelledby="maalaus-otsikko">
    <div class="container osio-otsake">
      <span class="eyebrow">Maalaus</span>
      <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
      <p class="lead">{maalaus.data.ingressi}</p>
    </div>
    <div class="reveal">
      <Kuva nimi="maalaus" ikoni="maalaus" variantti="leveä" />
    </div>
    <div class="container osio-alla">
      <p>
        Maalaamme rakennuksen yhteen tai kahteen kertaan pinnan kunnon mukaan. Lopuksi tarkistamme työn kanssasi,
        siivoamme työmaan ja kierrätämme jätteet asianmukaisesti.
      </p>
      <a href="/palvelut/maalaus/" class="link-arrow">Talon maalaus <Icon name="nuoli" size={18} /></a>
    </div>
  </section>

  <section class="section section--green" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Näin se toimii</span>
        <h2 id="vaiheet-otsikko">Kolme askelta valmiiseen kattoon</h2>
      </div>
      <Vaiheet />
    </div>
  </section>

  <section class="section" aria-labelledby="perhe-otsikko">
    <div class="container split">
      <Kuva nimi="perheyritys" ikoni="perhe" variantti="jaettu" />
      <div class="prose">
        <span class="eyebrow">Meistä</span>
        <h2 id="perhe-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
        <p>
          Perhekeskeisyys on tärkeimpiä arvojamme, ja se auttaa meitä tekemään työmme tehokkaasti. Luotamme toisiimme ja
          teemme kaiken sujuvalla yhteistyöllä.
        </p>
        <p>Asiakkaan tarpeet ovat meille ensisijaisia. Muokkaamme palvelun sinun kohteesi mukaan.</p>
        <a href="/meista/" class="link-arrow">Tutustu meihin <Icon name="nuoli" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section lisat" aria-labelledby="lisat-otsikko">
    <div class="container">
      <div class="lisat-otsikko">
        <h2 id="lisat-otsikko">Myös nämä hoituvat</h2>
        <a href="/palvelut/" class="link-arrow">Kaikki palvelut <Icon name="nuoli" size={18} /></a>
      </div>
      <ul class="lisakortit">
        {
          lisapalvelut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`} class="lisakortti">
                <Kuva nimi={p.data.kuva} ikoni={p.data.ikoni} variantti="kortti" />
                <span class="lisa-teksti">
                  <strong>
                    {p.data.nimi}
                    {etusivu.nosto === p.id && <span class="sesonki" data-alkaa={etusivu.alkaa} data-paattyy={etusivu.paattyy} hidden>Sesonki nyt</span>}
                  </strong>
                  <span>{p.data.kortti}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-label="Hinta ja palvelualue">
    <div class="container infot">
      <article class="info">
        <Icon name="laskin" size={32} />
        <h2>Mitä katon maalaus maksaa?</h2>
        <p>Hinta riippuu katon koosta, materiaalista ja kunnosta. Hintalaskurilla saat suuntaa ja voit lähettää tiedot suoraan meille.</p>
        <a href="/hintalaskuri/" class="link-arrow">Hintalaskuriin <Icon name="nuoli" size={18} /></a>
      </article>
      <article class="info">
        <Icon name="vahennys" size={32} />
        <h2>Kotitalousvähennys</h2>
        <p>{kvTila} {kvLuvut} Puolisot yhteensä enintään {kv.enimmaismaaraPuolisot.toLocaleString('fi-FI')} €.</p>
        <a href="/kotitalousvahennys/" class="link-arrow">Laske oma vähennys <Icon name="nuoli" size={18} /></a>
      </article>
      <article class="info">
        <Icon name="paikallinen" size={32} />
        <h2>Palvelualue</h2>
        <p>Teemme kattotöitä koko pääkaupunkiseudulla: {yritys.palvelualue.join(', ')}. Kotipaikkamme on Vantaa.</p>
        <a href="/yhteystiedot/" class="link-arrow">Yhteystiedot <Icon name="nuoli" size={18} /></a>
      </article>
    </div>
  </section>

  <CtaOsio otsikko="Varaa ilmainen katon kuntoarvio" palvelu="katot" />
</BaseLayout>

<script>
  // Sesonkimerkintä näkyy vain päivämäärävälillä (KK-PP), myös vuodenvaihteen yli
  document.querySelectorAll<HTMLElement>('.sesonki[data-alkaa]').forEach((el) => {
    const d = new Date();
    const nyt = `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const a = el.dataset.alkaa!;
    const p = el.dataset.paattyy!;
    el.hidden = !(a <= p ? nyt >= a && nyt <= p : nyt >= a || nyt <= p);
  });
</script>

<style>
  .hero { padding-top: clamp(2.5rem, 7vw, 6rem); }
  .hero-text {
    display: grid;
    gap: 1.4rem;
    justify-items: center;
    text-align: center;
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero-text .lead { margin-inline: auto; }
  .hero-text .btn-row { justify-content: center; }
  .hero-yhteys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero-yhteys > * { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; }
  .hero-yhteys :global(.icon) { color: var(--ok); flex: none; }
  .hero-yhteys a { color: var(--green); font-weight: 600; text-decoration: none; }
  .hero-kuva { padding-inline: var(--gutter); }
  @media (min-width: 1180px) {
    .hero-kuva { padding-inline: 0; }
  }

  .edut-osio {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .kattokortit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  @media (min-width: 64rem) {
    .kattokortit { grid-template-columns: repeat(3, 1fr); }
  }
  .kattokortit > li:not(.kattokortti-linkki) {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .kk-ikoni {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--moss-soft);
    color: var(--green);
    margin-bottom: 0.4rem;
  }
  .kattokortit h3 { font-size: 1.25rem; }
  .kattokortit p { color: var(--muted); font-size: 1.0625rem; }
  .kk-linkki {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    min-height: 10rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--green);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.15;
    text-decoration: none;
    transition: transform 240ms var(--ease-out), background-color 200ms ease;
  }
  .kk-linkki:hover { background: var(--green-deep); }
  .kk-linkki:active { transform: scale(0.985); }
  .kk-linkki :global(.icon) { flex: none; color: var(--orange); transition: transform 220ms var(--ease-out); }
  .kk-linkki:hover :global(.icon) { transform: translateX(4px); }

  .kuvaosio .reveal { padding-inline: var(--gutter); }
  @media (min-width: 1180px) {
    .kuvaosio .reveal { padding-inline: 0; }
  }
  .osio-otsake {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    max-width: 48rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .osio-otsake .lead { margin-inline: auto; }
  .osio-alla {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    max-width: 44rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  .merkit-rivi {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .merkit-rivi { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .merkit-cta { display: grid; gap: 1rem; }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .split { grid-template-columns: 1fr 1fr; }
    .split--reverse > :first-child { order: 2; }
  }
  .split .prose { min-width: 0; }
  .merkit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .merkit li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-weight: 500;
  }
  .merkit :global(.icon) { flex: none; color: var(--ok); margin-top: 0.2rem; }

  .huoltovalit {
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .huoltovalit div {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    border-top: 3px solid var(--orange);
    background: var(--surface);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }
  .huoltovalit dt { font-weight: 600; color: var(--green); font-size: 1.125rem; }
  .huoltovalit dd { margin: 0; color: var(--muted); }
  .huomio { margin-top: 1.5rem; color: var(--muted); }

  .lisat-otsikko {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .lisat-otsikko h2 { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem); }
  .lisakortit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  @media (min-width: 60rem) {
    .lisakortit { grid-template-columns: repeat(2, 1fr); }
  }
  .lisakortti {
    display: grid;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .lisakortti :global(.kuvapaikka) { transition: transform 400ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .lisakortti:hover :global(.kuvapaikka) { transform: scale(1.015); }
    .lisakortti:hover strong { text-decoration: underline; }
  }
  .lisakortti:active :global(.kuvapaikka) { transform: scale(0.985); }
  .lisa-teksti { display: grid; gap: 0.15rem; min-width: 0; }
  .lisa-teksti strong { color: var(--green); display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 1.25rem; }
  .lisa-teksti > span { color: var(--muted); }
  .sesonki {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--orange) 22%, transparent);
    color: #6b3d05;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .infot {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .info {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 2rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .info :global(.icon) { color: var(--orange); }
  .info h2 { font-family: var(--font-body); font-weight: 600; font-size: 1.375rem; letter-spacing: 0; }
  .info p { color: var(--muted); font-size: 1.0625rem; }
</style>
