---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Kuva from '../components/Kuva.astro';
import Icon from '../components/Icon.astro';
import Vaiheet from '../components/Vaiheet.astro';
import CtaOsio from '../components/CtaOsio.astro';
import TaloPiirros from '../components/TaloPiirros.astro';
import KattoProfiili from '../components/KattoProfiili.astro';
import Huoltovalit from '../components/Huoltovalit.astro';
import { getKuva } from '../lib/kuvat';
import yritys from '../data/yritys.json';

const katot = (await getEntry('palvelut', 'katot'))!;
const maalaus = (await getEntry('palvelut', 'maalaus'))!;
const muut = (await getCollection('palvelut', (p) => !p.data.ydin)).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const tel = `tel:${yritys.puhelinE164}`;
const heroKuva = getKuva('etusivu');

// Vanhan sivun kattosisällöstä
const merkit = [
  'Katolla kasvaa sammalta',
  'Peltikatossa näkyy ruostetta',
  'Katto vuotaa',
  'Tiilen pinta on kulunut tai hapristunut',
  'Katon väri on selvästi haalistunut',
];
---

<BaseLayout
  title="Kattoremontit ja katon maalaus pääkaupunkiseudulla | Holske"
  description="Kattoremontit, katon maalaus ja pinnoitus sekä talon maalaus omakotitaloille Helsingissä, Espoossa ja Vantaalla. Perheyritys, ilmainen kuntoarvio."
>
  <section class="hero">
    <div class="container hero-teksti">
      <h1>Katon maalaus ja kattoremontit omakotitaloille</h1>
      <div class="hero-ala">
        <p class="lead">
          Kunnostamme, maalaamme ja pinnoitamme tiili-, pelti- ja huopakatot siististi ja kiinteään hintaan. Pieni
          perheyritys pääkaupunkiseudulta, tekijöillä yli 25 vuoden kokemus.
        </p>
        <div class="toiminnot">
          <a href={tel} class="btn"><Icon name="puhelin" size={20} /> Soita {yritys.puhelinNaytto}</a>
          <a href={`mailto:${yritys.sahkoposti}`} class="sposti-linkki">{yritys.sahkoposti}</a>
        </div>
      </div>
    </div>
    {
      heroKuva ? (
        <div class="hero-kuva">
          <Kuva nimi="etusivu" ikoni="katto" variantti="hero" eager />
        </div>
      ) : (
        <div class="container hero-piirros">
          <TaloPiirros />
        </div>
      )
    }
  </section>

  <section class="section" aria-labelledby="katot-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="katot-otsikko">Kaikki kattotyöt yhdestä paikasta</h2>
        <p>Tunnemme eri katemateriaalit ja toteutustavat. Työ tehdään siististi, laadukkaasti ja kiinteään hintaan.</p>
      </div>
      <ul class="profiilirivit">
        {
          katot.data.alapalvelut.map((a) => (
            <li>
              <KattoProfiili tyyppi={a.nimi} />
              <h3>{a.nimi}</h3>
              <p>{a.teksti}</p>
            </li>
          ))
        }
      </ul>
      <a href="/palvelut/katot/" class="link-arrow lisaa">Lue lisää kattotöistä <Icon name="nuoli" size={18} /></a>
    </div>
  </section>

  <section class="section merkit-osio" aria-labelledby="merkit-otsikko">
    <div class="container kaksi">
      <div class="otsake">
        <h2 id="merkit-otsikko">Mistä tiedät, että katto tarvitsee huoltoa?</h2>
        <p>Tikkaille ei tarvitse kiivetä itse. Kun huomaat jonkin näistä, on hyvä aika soittaa. Kuntoarvio on ilmainen.</p>
      </div>
      <ol class="merkit">
        {merkit.map((m) => <li>{m}</li>)}
      </ol>
    </div>
    <div class="taysi reveal">
      <Kuva nimi="katto-huolto" ikoni="katto" variantti="leveä" vainJosOn />
    </div>
  </section>

  <section class="section" aria-labelledby="huolto-otsikko">
    <div class="container">
      <div class="osio-otsake">
        <h2 id="huolto-otsikko">Milloin katto ja seinät kannattaa maalata?</h2>
        <p>Pinnoitus voi pidentää tiilikaton käyttöikää jopa 20 vuodella.</p>
      </div>
      <Huoltovalit />
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="maalaus-otsikko">
    <div class="container rinnakkain">
      {getKuva('maalaus') ? (
        <Kuva nimi="maalaus" ikoni="maalaus" variantti="jaettu" />
      ) : (
        <dl class="rivit">
          {maalaus.data.alapalvelut.map((a) => (
            <div>
              <dt>{a.nimi}</dt>
              <dd>{a.teksti}</dd>
            </div>
          ))}
        </dl>
      )}
      <div class="otsake">
        <h2 id="maalaus-otsikko">{maalaus.data.otsikko}</h2>
        <p class="iso">{maalaus.data.ingressi}</p>
        <p>
          Maalaamme rakennuksen yhteen tai kahteen kertaan pinnan kunnon mukaan. Lopuksi tarkistamme työn kanssasi,
          siivoamme työmaan ja kierrätämme jätteet asianmukaisesti.
        </p>
        <a href="/palvelut/maalaus/" class="link-arrow">Lue lisää talon maalauksesta <Icon name="nuoli" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="vaiheet-otsikko">
    <div class="container">
      <h2 id="vaiheet-otsikko" class="osion-otsikko">Näin työ etenee</h2>
      <Vaiheet />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="muut-otsikko">
    <div class="container kaksi">
      <div class="otsake">
        <h2 id="muut-otsikko">Myös nämä hoituvat</h2>
        <p>Teemme samalla muut omakotitalon ulkotyöt, kun niitä tarvitaan.</p>
      </div>
      <ul class="linkkirivit">
        {
          muut.map((p) => (
            <li>
              <a href={`/palvelut/${p.id}/`}>
                <span>
                  <strong>{p.data.nimi}</strong>
                  <span class="kuvaus">{p.data.kortti}</span>
                </span>
                <Icon name="nuoli" size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section perhe" id="meista" aria-labelledby="meista-otsikko">
    <div class="container rinnakkain rinnakkain--kaanteinen">
      {getKuva('perheyritys') ? (
        <Kuva nimi="perheyritys" ikoni="perhe" variantti="jaettu" />
      ) : (
        <dl class="rivit">
          <div><dt>Yritys</dt><dd>{yritys.nimi}</dd></div>
          <div><dt>Y-tunnus</dt><dd>{yritys.ytunnus}</dd></div>
          <div><dt>Kotipaikka</dt><dd>{yritys.katuosoite}, {yritys.kaupunki}</dd></div>
          <div><dt>Palvelualue</dt><dd>{yritys.palvelualue.join(', ')}</dd></div>
        </dl>
      )}
      <div class="otsake">
        <h2 id="meista-otsikko">Pieni perheyritys. Tue paikallista tekijää.</h2>
        <p class="iso">
          Olemme suomalainen perheyritys pääkaupunkiseudulta. {yritys.kokemusLause}
        </p>
        <p>
          Perhekeskeisyys on tärkeimpiä arvojamme, ja se auttaa meitä tekemään työmme tehokkaasti. Asiakkaan tarpeet ovat
          meille ensisijaisia, ja muokkaamme työn sinun kohteesi mukaan.
        </p>
      </div>
    </div>
  </section>

  <CtaOsio />
</BaseLayout>

<style>
  /* Hero: kuusenvihreä pinta, iso leveä otsikko, alla talon piirros tai valokuva */
  .hero {
    background: var(--green);
    color: var(--green-text-on);
    padding-top: clamp(3rem, 8vw, 6.5rem);
    overflow: hidden;
  }
  .hero h1 { color: #fff; max-width: 14ch; }
  .hero-teksti { display: grid; gap: clamp(1.75rem, 4vw, 2.5rem); }
  .hero-ala {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }
  @media (min-width: 60rem) {
    .hero-ala { grid-template-columns: minmax(0, 36rem) auto; justify-content: space-between; gap: 3rem; }
  }
  .hero .lead { color: var(--green-text-on); }
  .toiminnot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; }
  .sposti-linkki {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 650;
    font-size: var(--fs-lg);
    color: #fff;
  }
  .hero :focus-visible { outline-color: var(--orange); }
  .hero-piirros { color: var(--green-text-on); margin-top: clamp(2.5rem, 6vw, 4rem); }
  .hero-kuva { margin-top: clamp(2.5rem, 6vw, 4rem); padding-inline: var(--gutter); }
  @media (min-width: 1180px) {
    .hero-kuva { padding-inline: 0; }
  }

  .osio-otsake {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .osio-otsake p,
  .otsake > p { color: var(--muted); max-width: var(--measure); }
  .otsake > p.iso { color: var(--ink); font-size: var(--fs-lg); }

  .profiilirivit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    border-top: 1px solid var(--line);
  }
  .profiilirivit li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 2rem 2rem 2.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .profiilirivit h3 { margin-top: 0.5rem; }
  .profiilirivit p { color: var(--muted); }
  .lisaa { margin-top: 2rem; }

  .kaksi { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 60rem) {
    .kaksi { grid-template-columns: 0.9fr 1.1fr; gap: 5rem; }
  }
  .otsake { display: grid; gap: 1.1rem; align-content: start; min-width: 0; }

  .merkit-osio { background: var(--green-deep); color: var(--green-text-on); }
  .merkit-osio h2 { color: #fff; }
  .merkit-osio .otsake > p { color: var(--green-text-on); }
  .merkit {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: m;
    border-top: 1px solid color-mix(in srgb, #fff 18%, transparent);
  }
  .merkit li {
    counter-increment: m;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, #fff 18%, transparent);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 600;
    font-stretch: 112%;
    color: #fff;
  }
  .merkit li::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 1px;
    background: var(--orange);
    transform: translateY(-0.15em) rotate(45deg);
  }
  .merkit-osio .taysi { margin-top: clamp(3rem, 7vw, 5rem); }
  .taysi { padding-inline: var(--gutter); }
  .taysi:not(:has(.kuvapaikka)) { display: none; }
  @media (min-width: 1180px) {
    .taysi { padding-inline: 0; }
  }

  .rinnakkain { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  @media (min-width: 60rem) {
    .rinnakkain { grid-template-columns: 1fr 1fr; }
    .rinnakkain > :first-child { order: 2; }
    .rinnakkain--kaanteinen > :first-child { order: 0; }
  }
  .rivit { margin: 0; border-top: 1px solid var(--line); align-self: center; }
  .rivit div { display: grid; gap: 0.3rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 44rem) {
    .rivit div { grid-template-columns: 11rem 1fr; gap: 1.5rem; }
  }
  .rivit dt { font-weight: 650; font-stretch: 108%; color: var(--green); }
  .rivit dd { margin: 0; color: var(--muted); }

  .osion-otsikko { margin-bottom: clamp(2rem, 5vw, 3rem); }

  .linkkirivit { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .linkkirivit a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .linkkirivit a > span { display: grid; gap: 0.25rem; min-width: 0; }
  .linkkirivit strong { font-size: 1.25rem; font-weight: 650; font-stretch: 112%; color: var(--green); }
  .linkkirivit .kuvaus { color: var(--muted); }
  .linkkirivit :global(.icon) { flex: none; color: var(--green); transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .linkkirivit a:hover :global(.icon) { transform: translateX(6px); }
    .linkkirivit a:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }
  }

  .perhe { border-top: 1px solid var(--line); }
</style>
