---
/**
 * Iso palvelukaruselli: kuva vasemmalla, teksti oikealla. Nuolinapit ja pyyhkäisy.
 * Kuva: palvelun oma kuva (src/content/palvelut/*.md kenttä `kuva`), varalla etusivun kuva.
 */
import { getCollection } from 'astro:content';
import Kuva from './Kuva.astro';
import Icon from './Icon.astro';

const palvelut = (await getCollection('palvelut')).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const kohdat = (p: (typeof palvelut)[number]) =>
  p.data.alapalvelut.filter((a) => !a.teksti.startsWith('TODO')).slice(0, 3).map((a) => a.nimi);
---

<div class="karuselli-kehys" data-karuselli-juuri>
  <ul class="liukuma" data-karuselli aria-label="Palvelut">
    {
      palvelut.map((p) => (
        <li class="dia">
          <a href={`/palvelut/${p.id}/`} class="kortti on-light">
            <span class="kortti-kuva">
              <Kuva nimi={p.data.kuva} vara={['etusivu']} alt={p.data.kuvaAlt} variantti="tayta" />
            </span>
            <span class="kortti-sisalto">
              <span class="eyebrow">{p.data.nimi}</span>
              <span class="kortti-otsikko">{p.data.otsikko}</span>
              <span class="kortti-teksti">{p.data.kortti}</span>
              {kohdat(p).length > 0 && (
                <span class="kohdat">
                  {kohdat(p).map((k) => (
                    <span class="kohta">
                      <Icon name="check" size={20} />
                      {k}
                    </span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="container napit">
    <button type="button" class="pyorea" data-edellinen aria-label="Edellinen palvelu">
      <Icon name="nuoli" size={24} class="kaannetty" />
    </button>
    <button type="button" class="pyorea" data-seuraava aria-label="Seuraava palvelu">
      <Icon name="nuoli" size={24} />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-karuselli-juuri]').forEach((juuri) => {
    const lista = juuri.querySelector<HTMLElement>('[data-karuselli]');
    const siirto = (suunta: number) => {
      if (!lista) return;
      const dia = lista.querySelector('li');
      const leveys = dia ? dia.getBoundingClientRect().width + 16 : 600;
      const loppu = lista.scrollLeft + lista.clientWidth >= lista.scrollWidth - 4;
      const alku = lista.scrollLeft <= 4;
      // Silmukka: lopusta alkuun ja alusta loppuun
      if (suunta > 0 && loppu) lista.scrollTo({ left: 0, behavior: 'smooth' });
      else if (suunta < 0 && alku) lista.scrollTo({ left: lista.scrollWidth, behavior: 'smooth' });
      else lista.scrollBy({ left: suunta * leveys, behavior: 'smooth' });
    };
    juuri.querySelector('[data-edellinen]')?.addEventListener('click', () => siirto(-1));
    juuri.querySelector('[data-seuraava]')?.addEventListener('click', () => siirto(1));
  });
</script>

<style>
  .liukuma {
    list-style: none;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(calc(100vw - 56px), 352px);
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  @media (min-width: 1025px) {
    .liukuma { grid-auto-columns: 448px; }
  }
  .liukuma::-webkit-scrollbar { display: none; }
  .dia { scroll-snap-align: start; display: grid; }
  .kortti {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-md);
    background: var(--surface);
    overflow: clip;
    text-decoration: none;
    transition: background-color 300ms ease;
  }
  .kortti:hover { color: inherit; }
  .kortti-kuva { position: relative; display: block; aspect-ratio: 4 / 3; }
  .kortti-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
  .kortti-sisalto { display: flex; flex-direction: column; gap: 16px; padding: 24px; flex: 1; }
  @media (min-width: 1025px) {
    .kortti-sisalto { padding: 36px; }
  }
  .kortti-otsikko {
    font-family: var(--font-display);
    font-stretch: var(--stretch);
    font-weight: 500;
    letter-spacing: 0.3px;
    font-size: 24px;
    line-height: 28px;
    color: var(--ink);
    text-wrap: balance;
  }
  .kortti-teksti { font-size: 18px; line-height: 24px; color: var(--ink-2); }
  .kohdat { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--p-grey-200); margin-top: auto; }
  .kohta { display: flex; align-items: center; gap: 10px; font-size: 18px; line-height: 24px; color: var(--ink); }
  .kohta :global(.icon) { flex: none; color: var(--p-olive); }
  .napit { display: flex; gap: 12px; margin-top: var(--sub-gap); }
  .pyorea {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--p-grey-100);
    color: var(--p-asphalt);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .pyorea:hover { background: var(--p-grey-200); }
  .pyorea :global(.kaannetty) { transform: scaleX(-1); }
</style>
