---
import RullaLuku from './RullaLuku.astro';
/** Huoltovälit vanhan sivun tiedoista: iso väli, alla mihin se koskee. */
const valit = [
  { vali: '2-3 v', kohde: 'Uusi sinkitty peltikatto', mita: 'ensimmäinen maalaus' },
  { vali: '5-10 v', kohde: 'Puutalon ulkoseinät', mita: 'uusi maalaus' },
  { vali: '15-20 v', kohde: 'Maalattu peltikatto', mita: 'uusi maalaus' },
  { vali: '20-30 v', kohde: 'Betonitiilikatto', mita: 'pinnoitus katon iän mukaan' },
];
---

<ul class="valit">
  {
    valit.map((v) => (
      <li>
        <RullaLuku arvo={v.vali} class="vali" />
        <span class="selite">
          <span class="kohde">{v.kohde}</span>
          <span class="mita">{v.mita}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .valit { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-radius: var(--r-md); overflow: hidden; }
  @media (min-width: 768px) {
    .valit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1280px) {
    .valit { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  li { display: flex; flex-direction: column; gap: 16px; padding: 36px 24px; background: var(--p-olive); }
  @media (min-width: 1025px) {
    li { padding: 48px 36px; }
  }
  li :global(.vali) {
    font-family: var(--font-display);
    font-stretch: var(--stretch);
    font-weight: 700;
    font-size: clamp(36px, 1.4rem + 1.8vw, 52px);
    line-height: 1.15;
    color: var(--p-birch);
    letter-spacing: 1.8px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .selite { display: grid; gap: 4px; }
  .kohde { font-weight: 600; font-size: 19px; line-height: 24px; color: var(--p-birch); }
  .mita { color: var(--p-grey-100); }
</style>
