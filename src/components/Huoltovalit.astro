---
/** Huoltovälit vanhan sivun tiedoista: iso väli, alla mihin se koskee. */
const valit = [
  { vali: '2-3 v', kohde: 'Uusi sinkitty peltikatto', mita: 'ensimmäinen maalaus' },
  { vali: '5-10 v', kohde: 'Puutalon ulkoseinät', mita: 'uusi maalaus' },
  { vali: '15-20 v', kohde: 'Maalattu peltikatto', mita: 'uusi maalaus' },
  { vali: '20-30 v', kohde: 'Betonitiilikatto', mita: 'pinnoitus katon iän mukaan' },
];
---

<ul class="valit">
  {
    valit.map((v) => (
      <li class="reveal">
        <span class="vali">{v.vali}</span>
        <span class="selite">
          <span class="kohde">{v.kohde}</span>
          <span class="mita">{v.mita}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .valit { list-style: none; margin: 0; padding: 0; display: grid; }
  li {
    display: grid;
    gap: 0.5rem 2rem;
    align-items: center;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  li + li { border-top: 1px solid var(--line); }
  @media (min-width: 40rem) {
    li { grid-template-columns: 13rem 1fr; }
  }
  .vali {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--green);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .selite { display: grid; gap: 0.15rem; }
  .kohde { font-weight: 650; font-size: var(--fs-lg); color: var(--ink); }
  .mita { color: var(--muted); }
</style>
