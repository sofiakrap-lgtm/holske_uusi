---
/** Huoltovälit vanhan sivun tiedoista: iso väli, alla mihin se koskee. */
const valit = [
  { vali: '2-3 v', kohde: 'Uusi sinkitty peltikatto', mita: 'ensimmäinen maalaus' },
  { vali: '5-10 v', kohde: 'Puutalon ulkoseinät', mita: 'uusi maalaus' },
  { vali: '15-20 v', kohde: 'Maalattu peltikatto', mita: 'uusi maalaus' },
  { vali: '20-30 v', kohde: 'Betonitiilikatto', mita: 'pinnoitus katon iän mukaan' },
];
---

<ul class="valit">
  {
    valit.map((v) => (
      <li>
        <span class="vali">{v.vali}</span>
        <span class="kohde">{v.kohde}</span>
        <span class="mita">{v.mita}</span>
      </li>
    ))
  }
</ul>

<style>
  .valit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  li { display: grid; gap: 0.35rem; align-content: start; }
  .vali {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--green);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }
  .kohde { font-weight: 650; font-size: var(--fs-lg); color: var(--ink); }
  .mita { color: var(--muted); }
</style>
