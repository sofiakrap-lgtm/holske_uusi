---
import Icon from './Icon.astro';
interface Props {
  href: string;
  nimi: string;
  teksti: string;
  ikoni: string;
  headingLevel?: 'h2' | 'h3';
}
const { href, nimi, teksti, ikoni, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<a href={href} class="palvelukortti">
  <span class="ikoni"><Icon name={ikoni} size={30} /></span>
  <H class="nimi">{nimi}</H>
  <p class="teksti">{teksti}</p>
  <span class="lue">Lue lisää <Icon name="nuoli" size={18} /></span>
</a>

<style>
  .palvelukortti {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      border-color 200ms ease;
  }
  .palvelukortti:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--green) 25%, var(--line));
  }
  .palvelukortti:active { transform: scale(0.985); transition-duration: 80ms; }
  .ikoni {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 14px;
    background: var(--moss-soft);
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .nimi { font-size: 1.375rem; }
  .teksti { color: var(--muted); font-size: 1.0625rem; }
  .lue {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--green);
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .lue :global(.icon) { transition: transform 220ms var(--ease-out); }
  .palvelukortti:hover .lue :global(.icon) { transform: translateX(3px); }
</style>
