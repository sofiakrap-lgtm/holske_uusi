---
/**
 * Työn vaiheet: numeroitu lista, neljä saraketta desktopissa, mobiilissa allekkain.
 */

const vaiheet = [
  { otsikko: 'Ota yhteyttä', teksti: 'Soita tai lähetä sähköpostia ja kerro lyhyesti, mitä kohteessa pitäisi tehdä.' },
  { otsikko: 'Ilmainen kuntoarvio', teksti: 'Katsomme kohteen paikan päällä ja teemme selkeän suunnitelman.' },
  { otsikko: 'Kiinteä hinta', teksti: 'Saat kiinteän hinnan ennen aloitusta ja päätät itse, jatketaanko.' },
  { otsikko: 'Työ ja tarkastus', teksti: 'Teemme työn siististi, tarkistamme tuloksen kanssasi ja kierrätämme jätteet.' },
];
---

<ol class="vaiheet">
  {
    vaiheet.map((v, i) => (
      <li class="on-light">
        <h3><span class="nro">{i + 1}.</span> {v.otsikko}</h3>
        <p>{v.teksti}</p>
      </li>
    ))
  }
</ol>

<style>
  .vaiheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .vaiheet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1025px) {
    .vaiheet { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--r-md);
    background: var(--surface);
  }
  @media (min-width: 768px) {
    li { padding: 32px; }
  }
  .nro { color: var(--muted); font-variant-numeric: tabular-nums; }
  h3 { font-size: clamp(20px, 1rem + 0.4vw, 24px); line-height: 1.15; }
  p { color: var(--muted); font-size: 17px; line-height: 24px; }

</style>
