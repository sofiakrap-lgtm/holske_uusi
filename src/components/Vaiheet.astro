---
const vaiheet = [
  {
    otsikko: 'Soita tai lähetä sähköpostia',
    teksti: 'Kerro lyhyesti, mitä kohteessa pitäisi tehdä. Sovitaan aika, jolloin tulemme katsomaan.',
  },
  {
    otsikko: 'Ilmainen kuntoarvio',
    teksti: 'Katsomme kohteen paikan päällä. Saat selkeän suunnitelman ja hinnan ilman sitoutumista.',
  },
  {
    otsikko: 'Työ tehdään siististi',
    teksti: 'Lopuksi tarkistamme tuloksen kanssasi, siivoamme työmaan ja kierrätämme jätteet.',
  },
];
---

<ol class="vaiheet">
  {
    vaiheet.map((v, i) => (
      <li>
        <span class="nro" aria-hidden="true">{i + 1}</span>
        <h3>{v.otsikko}</h3>
        <p>{v.teksti}</p>
      </li>
    ))
  }
</ol>

<style>
  .vaiheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  li { display: grid; gap: 0.6rem; align-content: start; }
  .nro {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
    border-radius: var(--r-sm);
    background: var(--green-fill);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
  }
  h3 { font-size: 1.25rem; }
  p { color: var(--muted); max-width: 26rem; }
</style>
