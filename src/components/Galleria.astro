---
/**
 * Kuvagalleria vaakasuuntaisena nauhana. Kuvat kansiosta assets/kuvat/galleria/ (tai sivuston kuvat, jos kansio on tyhjä).
 * Ei automaattista liikettä eikä toistoa: puhelimella pyyhkäistään, tietokoneella vieritetään tai käytetään nuolinäppäimiä.
 */
import Kuva from './Kuva.astro';
import { getGalleria } from '../lib/kuvat';

const nimet = getGalleria();
---

{
  nimet.length > 0 && (
    <div class="galleria container" tabindex="0" role="region" aria-label="Kuvagalleria, vieritä sivusuunnassa">
      <ul class="nauha">
        {nimet.map((n, i) => (
          <li class:list={[{ korkea: i % 3 === 1 }]}>
            <Kuva nimi={n} variantti={i % 3 === 1 ? 'jaettu' : 'kortti'} />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .galleria {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 12px;
  }
  .nauha {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 12px;
    width: max-content;
    align-items: center;
  }
  .nauha li { width: min(80vw, 26rem); flex: none; scroll-snap-align: start; }
  .nauha li.korkea { width: min(64vw, 19rem); }
  .nauha :global(.kuvapaikka) { border-radius: var(--r-md); }
  .nauha li.korkea :global(.kuvapaikka) { aspect-ratio: 4 / 5; }
  .nauha li:not(.korkea) :global(.kuvapaikka) { aspect-ratio: 4 / 3; }
</style>
