---
/**
 * Holsken logo SVG:nä suoraan sivulle, jolloin väri tulee CSS:n `color`-arvosta.
 * Logotiedostot: assets/logot-ja-grafiikat/logo.svg (päälogo) ja logo-pieni.svg (H.).
 */
const logot = import.meta.glob<string>('/assets/logot-ja-grafiikat/logo*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  variantti?: 'tumma' | 'vaalea';
  koko?: 'paa' | 'pieni';
  class?: string;
}
const { variantti = 'tumma', koko = 'paa', class: className } = Astro.props;
const tiedosto = koko === 'pieni' ? 'logo-pieni.svg' : 'logo.svg';
const raaka = Object.entries(logot).find(([p]) => p.endsWith('/' + tiedosto))?.[1] ?? '';

// Jokaiselle logolle omat id:t, ettei sama id toistu sivulla (header + footer)
const tunniste = Math.random().toString(36).slice(2, 7);
const svg = raaka
  .replace(/id="([^"]+)"/g, `id="$1-${tunniste}"`)
  .replace(/url\(#([^)]+)\)/g, `url(#$1-${tunniste})`)
  .replace('<svg ', '<svg class="logo-svg" focusable="false" ');
---

<span class:list={['logo', variantti, className]} set:html={svg} />

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--green);
    line-height: 0;
  }
  .logo.vaalea { color: #fff; }
  .logo :global(.logo-svg) {
    display: block;
    height: var(--logo-h, 1.75rem);
    width: auto;
    overflow: visible;
  }
</style>
