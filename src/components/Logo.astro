---
import { getLogo } from '../lib/kuvat';

interface Props {
  variantti?: 'tumma' | 'vaalea';
}
const { variantti = 'tumma' } = Astro.props;
// Oma logo: lisää assets/logot-ja-grafiikat/logo.svg (ja logo-valkoinen.svg footeriin)
const logo = getLogo(variantti === 'vaalea' ? 'logo-valkoinen' : 'logo');
---

{
  logo ? (
    <img src={logo.src} width={logo.width} height={logo.height} alt="Holske" class="logo-img" />
  ) : (
    <span class:list={['wordmark', variantti]} data-todo="Lisää logo: assets/logot-ja-grafiikat/logo.svg">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
        <path d="M3 15.5 16 5l13 10.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M7 13v13.5h18V13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M13 26.5v-7h6v7" fill="var(--orange)" />
      </svg>
      <span class="word">Holske</span>
    </span>
  )
}

<style>
  .logo-img { display: block; height: 2.5rem; width: auto; }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--green);
  }
  .wordmark.vaalea { color: #fff; }
  .word {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
    transform: translateY(1px);
  }
</style>
