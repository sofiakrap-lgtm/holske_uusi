---
/**
 * Työn vaiheet välilehtinä: vasemmalla kolme vaihetta, oikealla vaiheen kuva.
 * Aktiivinen vaihe vaihtuu itsestään 6 sekunnin välein (pysähtyy hiiren ollessa päällä).
 * Kuvapaikat: vaihe-1, vaihe-2, vaihe-3 (varalla sivuston muut kuvat).
 */
import Kuva from './Kuva.astro';

const vaiheet = [
  {
    otsikko: 'Ota yhteyttä',
    teksti: 'Kerro lyhyesti, mitä kohteessa pitäisi tehdä. Sovitaan aika, jolloin tulemme katsomaan.',
    kuva: 'vaihe-1',
    vara: ['etusivu'],
  },
  {
    otsikko: 'Ilmainen kuntoarvio',
    teksti: 'Katsomme kohteen paikan päällä. Saat selkeän suunnitelman ja hinnan ilman sitoutumista.',
    kuva: 'vaihe-2',
    vara: ['katto-huolto'],
  },
  {
    otsikko: 'Työ tehdään siististi',
    teksti: 'Lopuksi tarkistamme tuloksen kanssasi, siivoamme työmaan ja kierrätämme jätteet.',
    kuva: 'vaihe-3',
    vara: ['katot'],
  },
];
---

<div class="vaiheet" data-vaiheet>
  <div class="valilehdet" role="tablist" aria-label="Työn vaiheet">
    {
      vaiheet.map((v, i) => (
        <button
          type="button"
          role="tab"
          id={`vaihe-tab-${i}`}
          aria-controls={`vaihe-paneeli-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="valilehti"
          data-vaihe={i}
        >
          <span class="nro">{String(i + 1).padStart(2, '0')}</span>
          <span class="otsikko">{v.otsikko}</span>
          <span class="teksti">{v.teksti}</span>
          <span class="edistys" aria-hidden="true"><span></span></span>
        </button>
      ))
    }
  </div>
  <div class="kuvat">
    {
      vaiheet.map((v, i) => (
        <div
          class="paneeli"
          role="tabpanel"
          id={`vaihe-paneeli-${i}`}
          aria-labelledby={`vaihe-tab-${i}`}
          data-paneeli={i}
          data-aktiivinen={i === 0 ? '' : undefined}
        >
          <Kuva nimi={v.kuva} vara={v.vara} variantti="tayta" />
        </div>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-vaiheet]').forEach((juuri) => {
    const tabit = [...juuri.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneelit = [...juuri.querySelectorAll<HTMLElement>('[data-paneeli]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let nyt = 0;
    let ajastin: number | undefined;
    const KESTO = 6000;

    const valitse = (i: number, fokus = false) => {
      nyt = (i + tabit.length) % tabit.length;
      tabit.forEach((t, j) => {
        const on = j === nyt;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      paneelit.forEach((p, j) => p.toggleAttribute('data-aktiivinen', j === nyt));
      if (fokus) tabit[nyt].focus();
      kaynnista();
    };
    const kaynnista = () => {
      window.clearTimeout(ajastin);
      juuri.classList.remove('kay');
      if (reduce || juuri.matches(':hover, :focus-within')) return;
      void juuri.offsetWidth;
      juuri.classList.add('kay');
      ajastin = window.setTimeout(() => valitse(nyt + 1), KESTO);
    };

    tabit.forEach((t, i) => {
      t.addEventListener('click', () => valitse(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); valitse(i + 1, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); valitse(i - 1, true); }
      });
    });
    juuri.addEventListener('mouseenter', () => { window.clearTimeout(ajastin); juuri.classList.remove('kay'); });
    juuri.addEventListener('mouseleave', kaynnista);
    juuri.addEventListener('focusin', () => { window.clearTimeout(ajastin); juuri.classList.remove('kay'); });
    // Käynnistyy vasta kun osio näkyy
    new IntersectionObserver(([e]) => (e.isIntersecting ? kaynnista() : window.clearTimeout(ajastin)), { threshold: 0.3 }).observe(juuri);
  });
</script>

<style>
  .vaiheet { display: grid; gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  @media (min-width: 56rem) {
    .vaiheet { grid-template-columns: 5fr 7fr; }
  }
  .valilehdet { display: grid; gap: 0.25rem; }
  .valilehti {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--muted);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
  }
  .valilehti:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .valilehti[aria-selected='true'] { background: var(--surface); color: var(--ink-2); }
  :global(.section--sand) .valilehti[aria-selected='true'] { background: var(--bg); }
  .nro { font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
  .otsikko { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem); font-weight: 560; letter-spacing: -0.015em; color: var(--ink); }
  .teksti { font-size: 1rem; line-height: 1.5; max-width: 30rem; }
  .valilehti:not([aria-selected='true']) .teksti { display: none; }
  .edistys {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0.6rem;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
  }
  .edistys span { display: block; height: 100%; background: var(--green); transform: scaleX(0); transform-origin: left; }
  :global(.kay) .valilehti[aria-selected='true'] .edistys { opacity: 1; }
  :global(.kay) .valilehti[aria-selected='true'] .edistys span { animation: edistys 6000ms linear forwards; }
  @keyframes edistys { to { transform: scaleX(1); } }
  .kuvat {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .paneeli { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 400ms var(--ease-out), visibility 0s linear 400ms; }
  .paneeli[data-aktiivinen] { opacity: 1; visibility: visible; transition: opacity 400ms var(--ease-out), visibility 0s; }
  .paneeli :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
</style>
