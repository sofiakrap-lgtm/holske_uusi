---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import yritys from '../data/yritys.json';

const nav = [
  { href: '/palvelut/katot/', label: 'Kattoremontit' },
  { href: '/palvelut/maalaus/', label: 'Maalaus' },
  { href: '/palvelut/', label: 'Muut palvelut' },
  { href: '/yhteystiedot/', label: 'Yhteystiedot' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (href !== '/' && href !== '/palvelut/' && path.startsWith(href)) ||
  (href === '/palvelut/' && path.startsWith('/palvelut/') && !['/palvelut/katot/', '/palvelut/maalaus/'].includes(path));
const tel = `tel:${yritys.puhelinE164}`;
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${yritys.nimi}, etusivu`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Päävalikko">
      <ul id="paavalikko" class="nav-list" data-nav>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-mobile-only">
          <a href={tel} class="nav-phone">
            <Icon name="puhelin" size={20} />
            {yritys.puhelinNaytto}
          </a>
        </li>
        <li class="nav-mobile-only">
          <a href={`mailto:${yritys.sahkoposti}`} class="nav-phone">
            <Icon name="sahkoposti" size={20} />
            {yritys.sahkoposti}
          </a>
        </li>
        <li class="nav-mobile-only">
          <a href={tel} class="btn btn--block">Soita {yritys.puhelinNaytto}</a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a href={tel} class="phone" aria-label={`Soita ${yritys.puhelinNaytto}`}>
        <Icon name="puhelin" size={20} />
      </a>
      <a href={tel} class="btn cta"><Icon name="puhelin" size={18} /> Soita {yritys.puhelinNaytto}</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="paavalikko"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>Avaa valikko</span>
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Sulje valikko' : 'Avaa valikko';
    document.documentElement.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Varjo vasta kun sivua on vieritetty (IntersectionObserver, ei scroll-kuuntelijaa)
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (sentinel && header) {
    new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting)).observe(sentinel);
  }
</script>

<style>
  .header-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 24px; pointer-events: none; }
  /* Kelluva navigaatiosaareke: irrallaan yläreunasta, läpikuultava pinta */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.75rem;
    pointer-events: none;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
    padding-inline: 1.25rem 0.5rem;
    max-width: calc(var(--max) + 2rem);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 10px 30px -18px rgb(38 38 38 / 0.35);
    pointer-events: auto;
    transition: box-shadow 300ms var(--ease-out), background-color 300ms var(--ease-out);
  }
  @media (max-width: 82rem) {
    .bar { width: calc(100% - 2 * var(--gutter)); }
  }
  .site-header.is-scrolled .bar {
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 14px 36px -18px rgb(38 38 38 / 0.45);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--green);
    text-decoration: none;
    flex: none;
    min-height: 44px;
  }
  .nav { margin-left: auto; }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .nav-list a:hover { background: color-mix(in srgb, var(--green) 8%, transparent); }
  .nav-list a[aria-current='page'] {
    color: var(--green);
    background: color-mix(in srgb, var(--green) 10%, transparent);
  }
  .nav-mobile-only { display: none; }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    color: var(--green);
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .phone:hover { text-decoration: underline; }
  .cta {
    min-height: 3rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem;
    font-size: 1rem;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--green);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle:active { background: color-mix(in srgb, var(--green) 10%, transparent); }
  .menu-icon {
    position: relative;
    display: block;
    width: 22px;
    height: 12px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 280ms var(--ease-out), top 280ms var(--ease-out);
  }
  .menu-icon span:first-child { top: 0; }
  .menu-icon span:last-child { top: 10px; }
  .is-open .menu-icon span:first-child { top: 5px; transform: rotate(45deg); }
  .is-open .menu-icon span:last-child { top: 5px; transform: rotate(-45deg); }

  @media (min-width: 64rem) {
    .phone { display: none; }
  }

  @media (max-width: 63.99rem) {
    .bar { gap: 0.5rem; }
    .menu-toggle { display: grid; }
    .cta { display: none; }
    .actions { margin-left: auto; gap: 0.25rem; }
    .nav { margin: 0; }
    .bar { padding-inline: 1rem 0.35rem; }
    .nav-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.75rem var(--gutter) 1.5rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      box-shadow: 0 24px 40px -24px rgb(38 38 38 / 0.4);
      /* Valikko laskeutuu headerista, josta se avattiin, ja palaa samaa reittiä */
      transform-origin: top center;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition:
        transform 320ms var(--ease-out),
        opacity 200ms ease,
        visibility 0s linear 320ms;
    }
    .is-open .nav-list {
      transform: none;
      opacity: 1;
      visibility: visible;
      transition:
        transform 320ms var(--ease-out),
        opacity 200ms ease,
        visibility 0s;
    }
    .nav-list a {
      min-height: 3.25rem;
      padding-inline: 0.75rem;
      font-size: 1.1875rem;
      border-radius: var(--r-sm);
    }
    .nav-mobile-only { display: block; }
    .nav-mobile-only:first-of-type { margin-top: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.75rem; }
    .nav-phone { gap: 0.6rem; color: var(--green) !important; font-weight: 600 !important; }
    .nav-list .btn { margin-top: 0.5rem; color: var(--orange-ink); justify-content: center; }
    .nav-list .btn:hover { background: var(--orange-hover); }
  }

  @media (prefers-reduced-transparency: reduce) {
    .bar { background: var(--surface); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
</style>
