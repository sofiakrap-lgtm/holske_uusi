---
import Logo from './Logo.astro';
import yritys from '../data/yritys.json';

const nav = [
  { href: '/palvelut/katot/', label: 'Katot' },
  { href: '/palvelut/maalaus/', label: 'Maalaus' },
  { href: '/palvelut/', label: 'Palvelut' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (href !== '/palvelut/' && path.startsWith(href)) ||
  (href === '/palvelut/' && path.startsWith('/palvelut/') && !['/palvelut/katot/', '/palvelut/maalaus/'].includes(path));
---

<header class="site-header" data-header>
  <div class="sisus">
    <a href="/" class="brand" aria-label={`${yritys.nimi}, etusivu`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Päävalikko">
      <div class="segmentti" data-segmentti>
        <span class="liuku" aria-hidden="true" data-liuku></span>
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="toiminnot">
      <a href="/yhteystiedot/" class="btn btn--toiminto">Ota yhteyttä</a>
      <button type="button" class="valikko-nappi" aria-expanded="false" aria-controls="mobiilivalikko" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Avaa valikko</span>
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="arkki" id="mobiilivalikko" data-nav>
    <div class="arkki-sisus">
      <p class="ryhma">Sivut</p>
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Etusivu</a></li>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href="/yhteystiedot/" aria-current={path === '/yhteystiedot/' ? 'page' : undefined}>Yhteystiedot</a></li>
      </ul>
    </div>
  </div>
  <div class="scrim" data-scrim aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const scrim = document.querySelector<HTMLElement>('[data-scrim]');

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Sulje valikko' : 'Avaa valikko';
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  scrim?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia('(min-width: 820px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Varatoteutus selaimille ilman scroll-timelinea: tausta peittäväksi vierityksen jälkeen
  if (!CSS.supports('animation-timeline: scroll()') && header) {
    const anturi = document.createElement('div');
    anturi.style.cssText = 'position:absolute;top:0;height:96px;width:1px;pointer-events:none';
    document.body.prepend(anturi);
    new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting)).observe(anturi);
  }

  // Segmenttinavigaation liukuva valintapilleri (aktiivinen kohta, hoverissa liukuu)
  const seg = document.querySelector<HTMLElement>('[data-segmentti]');
  const liuku = document.querySelector<HTMLElement>('[data-liuku]');
  if (seg && liuku) {
    const linkit = [...seg.querySelectorAll<HTMLAnchorElement>('a')];
    const aktiivinen = linkit.find((a) => a.getAttribute('aria-current') === 'page');
    const siirra = (a?: HTMLElement) => {
      if (!a) { liuku.style.opacity = '0'; return; }
      liuku.style.opacity = '1';
      liuku.style.left = `${a.offsetLeft}px`;
      liuku.style.width = `${a.offsetWidth}px`;
    };
    siirra(aktiivinen);
    linkit.forEach((a) => {
      a.addEventListener('mouseenter', () => siirra(a));
      a.addEventListener('focus', () => siirra(a));
    });
    seg.addEventListener('mouseleave', () => siirra(aktiivinen));
    document.fonts?.ready.then(() => siirra(aktiivinen));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: var(--overlay);
    transition: background-color var(--dur-base) ease;
  }
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: kaista linear both;
      animation-timeline: scroll();
      animation-range: 0 96px;
    }
    @keyframes kaista {
      from { background-color: transparent; }
      to { background-color: var(--overlay); }
    }
  }
  @supports not (animation-timeline: scroll()) {
    .site-header { background: transparent; }
    .site-header:global(.is-scrolled) { background: var(--overlay); }
  }
  .site-header.is-open { animation: none; background: var(--overlay); }
  /* Palvelusivuilla pääosiossa ei ole yläusvaa, joten palkki on heti umpinainen */
  :global(body:has(.paaosio--suora)) .site-header { animation: none; background: var(--overlay); }
  .sisus {
    position: relative;
    z-index: 2;
    max-width: var(--max);
    height: 100%;
    margin: 0 auto;
    padding-inline: 24px 12px;
    display: flex;
    align-items: center;
    column-gap: 8px;
  }
  @media (min-width: 768px) {
    .sisus { padding-inline: 36px 24px; }
  }
  @media (min-width: 1025px) {
    .sisus { padding-inline: 36px; }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand :global(.logo) { --logo-h: 1.9rem; color: var(--ink); }
  @media (min-width: 768px) {
    .brand :global(.logo) { --logo-h: 2.1rem; }
  }
  .nav { margin-inline-start: 24px; }
  @media (max-width: 819px) {
    .nav { display: none; }
  }
  .segmentti {
    position: relative;
    display: flex;
    padding: 4px;
    border-radius: 999px;
  }
  .liuku {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: 0;
    border-radius: 999px;
    background: var(--p-grey-100);
    opacity: 0;
    transition:
      left 260ms var(--ease-standard),
      width 260ms var(--ease-standard),
      opacity 140ms ease;
  }
  .segmentti a {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font: 600 16px/1 var(--font-body);
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .segmentti a:hover { color: var(--ink); }
  .toiminnot { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 6px; }
  .btn--toiminto { --btn-bg: var(--p-olive); --btn-fg: var(--p-birch); --btn-h: 36px; --btn-px: 16px; font-size: 15px; }
  .btn--toiminto:hover { --btn-bg: var(--p-olive-700); }
  @media (min-width: 768px) {
    .btn--toiminto { --btn-h: 38px; --btn-px: 18px; font-size: 16px; }
    .toiminnot { gap: 12px; }
  }
  .valikko-nappi {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  @media (max-width: 819px) {
    .valikko-nappi { display: grid; }
  }
  .menu-icon { position: relative; display: block; width: 22px; height: 12px; }
  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-standard), top var(--dur-base) var(--ease-standard);
  }
  .menu-icon span:first-child { top: 0; }
  .menu-icon span:last-child { top: 10px; }
  .is-open .menu-icon span:first-child { top: 5px; transform: rotate(45deg); }
  .is-open .menu-icon span:last-child { top: 5px; transform: rotate(-45deg); }

  /* Mobiilivalikko: arkki laskeutuu headerin alta */
  .arkki {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding-top: var(--header-h);
    background: var(--overlay);
    border-radius: 0 0 24px 24px;
    transform: translateY(-100%);
    visibility: hidden;
    transition: transform 180ms var(--ease-standard), visibility 0s linear 180ms;
  }
  .is-open .arkki {
    transform: none;
    visibility: visible;
    transition: transform 240ms var(--ease-standard), visibility 0s;
  }
  .arkki-sisus { padding: 12px 24px 24px; }
  .ryhma { padding: 0 22px; font: 600 16px/22px var(--font-body); color: var(--muted); margin-bottom: 8px; }
  .arkki ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .arkki a {
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font: 600 16px/1 var(--font-body);
    color: var(--ink);
    text-decoration: none;
  }
  .arkki a[aria-current='page'] { background: var(--p-grey-100); }
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: rgb(18 17 14 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, visibility 0s linear 180ms;
  }
  .is-open .scrim { opacity: 1; visibility: visible; transition: opacity 240ms ease, visibility 0s; }
  @media (min-width: 820px) {
    .arkki,
    .scrim { display: none; }
  }
</style>
