---
/**
 * Ikonit Phosphor-kirjastosta (@phosphor-icons/core, paino regular).
 * Käyttö: <Icon name="puhelin" size={24} />
 */
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;

const NIMET: Record<string, string> = {
  katto: 'house-line',
  maalaus: 'paint-roller',
  painepesu: 'drop',
  lumi: 'snowflake',
  piha: 'plant',
  korjaus: 'wrench',
  puhelin: 'phone',
  sahkoposti: 'envelope-simple',
  sijainti: 'map-pin',
  yritys: 'buildings',
  nuoli: 'arrow-right',
  check: 'check',
  menu: 'list',
  sulje: 'x',
  plus: 'plus',
  kuva: 'image',
  info: 'info',
  varoitus: 'warning-circle',
  nuoliYlos: 'arrow-up-right',
  alas: 'caret-down',
  kuntoarvio: 'clipboard-text',
  hinta: 'tag',
  siisti: 'broom',
  tiesitko: 'lightbulb',
  kalenteri: 'calendar-check',
};

const require = createRequire(import.meta.url);
const tiedosto = require.resolve(`@phosphor-icons/core/assets/regular/${NIMET[name] ?? 'info'}.svg`);
const body = readFileSync(tiedosto, 'utf8')
  .replace(/^<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
