---
import yritys from '../data/yritys.json';
interface Props {
  otsikko?: string;
  teksti?: string;
}
const {
  otsikko = 'Soita, niin tulemme katsomaan',
  teksti = 'Kuntoarvio on ilmainen. Tulemme paikalle, katsomme kohteen ja kerromme, mitä se tarvitsee. Saat suunnitelman ja hinnan ilman sitoutumista.',
} = Astro.props;
const tel = `tel:${yritys.puhelinE164}`;
---

<section class="yhteys" aria-labelledby="yhteys-otsikko">
  <div class="container sisus">
    <h2 id="yhteys-otsikko">{otsikko}</h2>
    <p class="lead">{teksti}</p>
    <a href={tel} class="numero">{yritys.puhelinNaytto}</a>
    <a href={`mailto:${yritys.sahkoposti}`} class="sposti">{yritys.sahkoposti}</a>
    <p class="alue">{yritys.palvelualue.join(' · ')}</p>
  </div>
</section>

<style>
  .yhteys {
    background: var(--green);
    color: var(--green-text-on);
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .sisus {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
    max-width: 48rem;
  }
  h2 { color: #fff; }
  .lead { color: color-mix(in srgb, #fff 82%, transparent); margin-inline: auto; }
  .numero {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
    font-variant-numeric: lining-nums;
    padding: 0.25rem 0.5rem;
    border-radius: var(--r-sm);
    transition: color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .numero:hover { color: var(--orange); }
  }
  .sposti {
    color: #fff;
    font-size: var(--fs-lg);
    font-weight: 500;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .alue { color: color-mix(in srgb, #fff 65%, transparent); font-size: var(--fs-sm); letter-spacing: 0.02em; }
</style>
