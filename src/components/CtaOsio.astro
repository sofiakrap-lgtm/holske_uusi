---
import yritys from '../data/yritys.json';
import Icon from './Icon.astro';
interface Props {
  otsikko?: string;
  teksti?: string;
}
const {
  otsikko = 'Soita, niin tulemme katsomaan',
  teksti = 'Kuntoarvio on ilmainen. Katsomme kohteen paikan päällä ja kerromme, mitä se tarvitsee. Saat suunnitelman ja hinnan ilman sitoutumista.',
} = Astro.props;
const tel = `tel:${yritys.puhelinE164}`;
---

<section class="yhteys" aria-labelledby="yhteys-otsikko">
  <div class="container">
    <div class="paneeli">
      <div class="teksti">
        <h2 id="yhteys-otsikko">{otsikko}</h2>
        <p>{teksti}</p>
      </div>
      <div class="toiminnot">
        <a href={tel} class="numero">{yritys.puhelinNaytto}</a>
        <div class="napit">
          <a href={tel} class="btn"><Icon name="puhelin" size={20} /> Soita</a>
          <a href={`mailto:${yritys.sahkoposti}`} class="sposti"><Icon name="sahkoposti" size={20} /> {yritys.sahkoposti}</a>
        </div>
        <p class="alue">Palvelualue: {yritys.palvelualue.join(', ')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .yhteys { padding-block: var(--section); }
  .paneeli {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--r-md);
    background: var(--green-fill);
    color: var(--green-text-on);
  }
  @media (min-width: 60rem) {
    .paneeli { grid-template-columns: 1fr 1fr; align-items: end; }
  }
  .teksti { display: grid; gap: 1rem; }
  h2 { color: #fff; max-width: 14ch; }
  .teksti p { max-width: 34rem; color: var(--green-text-on); }
  .toiminnot { display: grid; gap: 1.25rem; justify-items: start; }
  .numero {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: clamp(2.2rem, 1.2rem + 4.4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .numero:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.14em; }
  }
  .napit { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .sposti {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    color: #fff;
    font-weight: 600;
  }
  .alue { font-size: var(--fs-sm); color: color-mix(in srgb, var(--green-text-on) 85%, transparent); }
  .paneeli :focus-visible { outline-color: var(--green-text-on); }
</style>
