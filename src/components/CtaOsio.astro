---
import yritys from '../data/yritys.json';
interface Props {
  otsikko?: string;
  teksti?: string;
}
const {
  otsikko = 'Soita, niin tulemme katsomaan',
  teksti = 'Kuntoarvio on ilmainen. Tulemme paikalle, katsomme kohteen ja kerromme, mitä se tarvitsee. Saat suunnitelman ja hinnan ilman sitoutumista.',
} = Astro.props;
const tel = `tel:${yritys.puhelinE164}`;
---

<section class="yhteys" aria-labelledby="yhteys-otsikko">
  <div class="container sisus">
    <h2 id="yhteys-otsikko">{otsikko}</h2>
    <p class="lead">{teksti}</p>
    <a href={tel} class="numero">{yritys.puhelinNaytto}</a>
    <a href={`mailto:${yritys.sahkoposti}`} class="sposti">{yritys.sahkoposti}</a>
    <p class="alue">{yritys.palvelualue.join(' · ')}</p>
  </div>
</section>

<style>
  .yhteys {
    background: var(--orange);
    color: var(--ink);
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .sisus {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: var(--max);
  }
  h2 { color: var(--ink); max-width: 18ch; }
  .lead { color: var(--ink); max-width: 38rem; }
  .numero {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 780;
    font-stretch: 125%;
    font-size: clamp(1.9rem, 0.6rem + 8vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .numero:hover { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 0.12em; }
  }
  .sposti {
    color: var(--ink);
    font-size: var(--fs-lg);
    font-weight: 650;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .alue { color: var(--ink); font-size: var(--fs-sm); letter-spacing: 0.04em; }
  :focus-visible { outline-color: var(--ink); }
</style>
