---
interface Props {
  otsikko?: string;
  teksti?: string;
}
const { otsikko = 'Katsotaanko kattosi?', teksti = 'Kuntoarvio on ilmainen ja ilman sitoutumista.' } = Astro.props;
---

<section class="cta" data-theme="asphalt" aria-labelledby="yhteys-otsikko">
  <div class="container sisus">
    <h2 id="yhteys-otsikko" data-fit>{otsikko}</h2>
    <p>{teksti}</p>
    <a href="/yhteystiedot/" class="btn btn--l">Ota yhteyttä</a>
  </div>
</section>

<style>
  .cta { padding-block: 96px; }
  .sisus { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  p { color: var(--muted); font-weight: 600; font-size: clamp(18px, 1rem + 0.4vw, 24px); }
  .btn { margin-top: 8px; }
</style>
