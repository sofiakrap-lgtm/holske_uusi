---
interface Props {
  otsikko?: string;
  teksti?: string;
}
const {
  otsikko = 'Tarvitseeko kattosi huoltoa?',
  teksti = 'Kuntoarvio on ilmainen, ja saat suunnitelman ja hinnan ilman sitoutumista.',
} = Astro.props;
---

<section class="yhteys" aria-labelledby="yhteys-otsikko">
  <div class="container sisus reveal">
    <h2 id="yhteys-otsikko">{otsikko}</h2>
    <p>{teksti}</p>
    <a href="/yhteystiedot/" class="btn btn--iso">Ota yhteyttä</a>
  </div>
</section>

<style>
  .yhteys { padding-block: var(--section); text-align: center; }
  .sisus { display: grid; justify-items: center; gap: 1.25rem; }
  h2 { max-width: 16ch; }
  p { max-width: 34rem; color: var(--muted); font-size: var(--fs-lg); }
  .btn { margin-top: 0.75rem; }
</style>
