---
/**
 * Neliön muotoinen hero-video. Lisää tiedostot kansioon public/video/:
 *   <nimi>.mp4 (pakollinen), <nimi>.webm (valinnainen), <nimi>-poster.jpg (suositeltu)
 * Ilman videota näytetään värillinen neliö.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  nimi: string;
  kuvaus?: string;
}
const { nimi, kuvaus = '' } = Astro.props;
const kansio = join(process.cwd(), 'public', 'video');
const mp4 = existsSync(join(kansio, `${nimi}.mp4`));
const webm = existsSync(join(kansio, `${nimi}.webm`));
const poster = existsSync(join(kansio, `${nimi}-poster.jpg`)) ? `/video/${nimi}-poster.jpg` : undefined;
---

<div class="hero-media" data-hero-media>
  {
    mp4 ? (
      <video autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true" data-hero-video>
        {webm && <source src={`/video/${nimi}.webm`} type="video/webm" />}
        <source src={`/video/${nimi}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <div class="vari" role="img" aria-label={kuvaus} />
    )
  }
</div>

<script>
  // Video häivytetään posterin päälle, kun se voi toistua, ja pysäytetään kun se ei näy
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) v.pause();
    v.addEventListener('canplay', () => v.classList.add('valmis'), { once: true });
    if (v.readyState >= 3) v.classList.add('valmis');
    new IntersectionObserver(([e]) => {
      if (reduce.matches) return;
      e.isIntersecting ? v.play().catch(() => {}) : v.pause();
    }).observe(v);
  }
</script>

<style>
  .hero-media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--green-fill);
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    video { opacity: 0; transition: opacity 600ms var(--ease-out); }
    video[poster] { opacity: 1; }
    video:global(.valmis) { opacity: 1; }
  }
  .vari {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 20% 10%, rgb(255 255 255 / 0.1), transparent 60%),
      var(--green-fill);
  }
</style>
