---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import yritys from '../data/yritys.json';
import { getCollection } from 'astro:content';

const palvelut = (await getCollection('palvelut')).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const vuosi = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="col brand-col">
      <a href="/" class="brand" aria-label="Holske Oy, etusivu"><Logo class="footer-logo" /></a>
      <p class="tagline">Katot ja seinät kuntoon. Siististi ja kiinteään hintaan.</p>
      <a href="/yhteystiedot/" class="btn">Ota yhteyttä</a>
    </div>

    <div class="col">
      <h2 class="col-title">Yhteystiedot</h2>
      <ul class="list">
        <li><Icon name="sahkoposti" size={20} /><a href={`mailto:${yritys.sahkoposti}`}>{yritys.sahkoposti}</a></li>
        <li>
          <Icon name="sijainti" size={20} />
          <span>{yritys.katuosoite}, {yritys.postinumero} {yritys.kaupunki}</span>
        </li>
        <li><Icon name="yritys" size={20} /><span>{yritys.nimi}, Y-tunnus {yritys.ytunnus}</span></li>
      </ul>
    </div>

    <nav class="col" aria-label="Palvelut">
      <h2 class="col-title">Palvelut</h2>
      <ul class="list plain">
        {palvelut.map((p) => <li><a href={`/palvelut/${p.id}/`}>{p.data.nimi}</a></li>)}
      </ul>
    </nav>

    <nav class="col" aria-label="Sivusto">
      <h2 class="col-title">Holske</h2>
      <ul class="list plain">
        <li><a href="/yhteystiedot/">Yhteystiedot</a></li>
        <li><a href="/tietosuojaseloste/">Tietosuojaseloste</a></li>
        <li><button type="button" class="linklike" data-evasteasetukset>Evästeasetukset</button></li>
      </ul>
    </nav>
  </div>

  <div class="container bottom">
    <p>
      {yritys.nimi} (Y-tunnus {yritys.ytunnus}) on vantaalainen perheyritys, joka tekee kattoremontteja, katon ja talon
      maalausta, painepesua, lumitöitä ja pihatöitä: {yritys.palvelualue.join(', ')}.
    </p>
    <p>© {vuosi} {yritys.nimi}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--p-grey-50);
    color: var(--ink-2);
    padding-block: var(--section) 48px;
    font-size: 16px;
    line-height: 22px;
    box-shadow: 0 50vh 0 0 var(--p-grey-50);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .brand-col {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
    grid-column: span 1;
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: 1.4fr 1.3fr 1fr 1fr; }
  }
  .brand { color: var(--ink); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .tagline { max-width: 17rem; font-family: var(--font-display); font-stretch: var(--stretch); font-weight: 500; letter-spacing: 0.3px; font-size: 16px; line-height: 1.3; color: var(--ink-2); }
  .brand :global(.footer-logo) { --logo-h: 1.6rem; color: var(--ink); }
  .col-title {
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: 0;
    line-height: 22px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
  }
  .list :global(.icon) { flex: none; color: var(--muted); }
  .list a,
  .linklike {
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .list a:hover,
  .linklike:hover { text-decoration: underline; }
  .linklike {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    min-height: 44px;
  }
  .bottom {
    display: grid;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
  }
</style>
