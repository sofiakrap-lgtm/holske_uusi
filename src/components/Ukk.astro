---
import Icon from './Icon.astro';
interface Props {
  kysymykset: { k: string; v: string }[];
}
const { kysymykset } = Astro.props;
---

<div class="ukk">
  {
    kysymykset.map((q) => (
      <details name="ukk">
        <summary>
          <span class="k">{q.k}</span>
          <span class="ind"><Icon name="alas" size={28} /></span>
        </summary>
        <div class="v"><p>{q.v}</p></div>
      </details>
    ))
  }
</div>

<style>
  .ukk { display: flex; flex-direction: column; }
  details { interpolate-size: allow-keywords; }
  details + details { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 12px; }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size var(--dur-slow) var(--ease-in-out),
      opacity 200ms ease,
      content-visibility var(--dur-slow) allow-discrete;
  }
  details[open]::details-content { block-size: auto; opacity: 1; transition-timing-function: var(--ease-emphasis), ease, linear; }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .k { font: 600 20px/24px var(--font-body); color: var(--ink); transition: color var(--dur-fast); }
  @media (min-width: 1025px) {
    .k { font-size: 24px; line-height: 32px; }
  }
  summary:hover .k { color: var(--ink-2); }
  .ind { display: flex; color: var(--ink); transition: transform var(--dur-fast) ease; }
  details[open] .ind { transform: rotate(180deg); }
  .v { padding: 0 48px 12px 0; }
  .v p { font-size: 18px; line-height: 24px; color: var(--ink-2); }
  @media (min-width: 1025px) {
    .v p { font-size: 20px; line-height: 28px; }
  }
</style>
