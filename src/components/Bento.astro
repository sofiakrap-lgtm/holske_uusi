---
/**
 * Ruudukko, jossa kuva on keskellä ja tekstisolut sen ympärillä (vasen ja oikea sarake).
 * Solu voi olla linkki (href). korostus = solun indeksi, joka saa oliivin pohjan.
 */
import Kuva from './Kuva.astro';
import Icon from './Icon.astro';
import { ensimmainenKuva } from '../lib/kuvat';

interface Solu {
  otsikko: string;
  teksti?: string;
  href?: string;
  ikoni?: string;
}
interface Props {
  kuva: string;
  alt?: string;
  solut: Solu[];
  korostus?: number;
  vara?: string[];
  /** Pieni ikoni tekstisolujen yläkulmaan (linkkisoluissa nuoli) */
  ikoni?: string;
}
const { kuva, alt, solut, korostus = -1, vara = [], ikoni } = Astro.props;
const onKuva = !!ensimmainenKuva(kuva, ...vara);
const vasen = Math.ceil(solut.length / 2);
const rivit = Math.max(vasen, solut.length - vasen);
---

<div class:list={['bento', { 'bento--kuva': onKuva }]} style={`--rivit:${rivit}`}>
  {
    onKuva && (
      <div class="bento-kuva">
        <Kuva nimi={kuva} vara={vara} alt={alt} variantti="tayta" />
      </div>
    )
  }
  {
    solut.map((s, i) => {
      const puoli = i < vasen ? 'vasen' : 'oikea';
      const rivi = i < vasen ? i + 1 : i - vasen + 1;
      const luokat = ['solu', `solu--${puoli}`, { 'solu--korostus': i === korostus, 'solu--hiekka': i % 2 === 1, 'on-light': i !== korostus }];
      const tyyli = `--rivi:${rivi}`;
      return s.href ? (
        <a href={s.href} class:list={[...luokat, 'solu--linkki']} style={tyyli}>
          <span class="merkki merkki--nuoli"><Icon name="nuoli" size={26} paino="light" /></span>
          <h3>{s.otsikko}</h3>
          {s.teksti && <p>{s.teksti}</p>}
        </a>
      ) : (
        <div class:list={luokat} style={tyyli}>
          {(s.ikoni ?? ikoni) && <span class="merkki"><Icon name={(s.ikoni ?? ikoni)!} size={28} paino="light" /></span>}
          <h3>{s.otsikko}</h3>
          {s.teksti && <p>{s.teksti}</p>}
        </div>
      );
    })
  }
</div>

<style>
  .bento { display: grid; gap: 2px; border-radius: var(--r-md); overflow: hidden; }
  @media (min-width: 40rem) {
    .bento { grid-template-columns: 1fr 1fr; }
    .bento-kuva { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .bento--kuva {
      grid-template-columns: 1fr 1.3fr 1fr;
      grid-template-rows: repeat(var(--rivit), auto);
    }
    .bento--kuva .bento-kuva { grid-column: 2; grid-row: 1 / span var(--rivit); }
    .bento--kuva .solu--vasen { grid-column: 1; grid-row: var(--rivi); }
    .bento--kuva .solu--oikea { grid-column: 3; grid-row: var(--rivi); }
  }
  .bento-kuva { position: relative; min-height: 20rem; overflow: hidden; }
  .bento-kuva :global(.kuvapaikka) { position: absolute; inset: 0; height: 100%; min-height: 0; border-radius: 0; }
  .solu {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 12px;
    min-height: 9rem;
    padding: 24px;
    background: var(--surface);
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .solu { padding: 36px; }
  }
  @media (min-width: 64rem) {
    .solu { min-height: 13rem; }
  }
  .solu--hiekka { background: var(--sand); }
  .solu h3 { font-size: clamp(20px, 1rem + 0.5vw, 26px); line-height: 1.15; }
  .solu p { color: var(--muted); font-size: 18px; line-height: 24px; }
  .solu--korostus { background: var(--korostus, var(--p-asphalt)); }
  .solu--korostus h3 { color: var(--p-birch); }
  .solu--korostus p { color: var(--p-grey-200); }
  /* Ikoni samalla paikalla joka solussa, otsikot samalla tasolla */
  .merkki {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    border-radius: 12px;
    background: var(--p-grey-100);
    color: var(--p-asphalt);
  }
  .solu--hiekka .merkki { background: var(--p-birch); }
  .solu--korostus .merkki { background: rgb(255 254 247 / 0.14); color: var(--p-birch); }
  .solu--linkki .merkki--nuoli { transition: transform var(--dur-fast) ease; }
  .solu--linkki:hover .merkki--nuoli { transform: translateX(4px); }
  .solu--linkki { transition: background-color 300ms ease; }
  .solu--linkki.solu--korostus:hover { background: var(--p-grey-900); }
  .solu--korostus:focus-visible { outline-color: var(--p-grey-400); }
</style>
